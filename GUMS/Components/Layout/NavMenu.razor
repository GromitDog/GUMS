@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="/UnitLogowhite.png" alt="Girl Guiding Unit Logo" class="unit-logo" />
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="if(event.target.closest('a.nav-link')) document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" >
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Register" Match="NavLinkMatch.All">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Member Register
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="Meetings" Match="NavLinkMatch.All">
                <span class="bi bi-calendar-week" aria-hidden="true"></span> Meetings
            </NavLink>
        </div>

        <!-- Programme Section (Expandable) -->
        <div class="nav-item px-3">
            <div class="nav-link nav-group-toggle @(_programmeExpanded ? "expanded" : "")" @onclick="ToggleProgramme" @onclick:stopPropagation="true">
                <span class="bi bi-award" aria-hidden="true"></span> Programme
                <span class="bi @(_programmeExpanded ? "bi-chevron-down" : "bi-chevron-right") nav-chevron" aria-hidden="true"></span>
            </div>
            @if (_programmeExpanded)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link nav-link-sub" href="Programme/Badges">
                        <span class="bi bi-bookmark-star" aria-hidden="true"></span> Badges
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Programme/Umas">
                        <span class="bi bi-clipboard-check" aria-hidden="true"></span> UMAs
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Programme/Overview">
                        <span class="bi bi-grid-3x3" aria-hidden="true"></span> Unit Overview
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Programme/Awards">
                        <span class="bi bi-trophy" aria-hidden="true"></span> Awards Due
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Programme/TermBalance">
                        <span class="bi bi-pie-chart" aria-hidden="true"></span> Term Balance
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Reports/NightsAway">
                        <span class="bi bi-moon-stars" aria-hidden="true"></span> Nights Away
                    </NavLink>
                </div>
            }
        </div>

        <!-- Finance Section (Expandable) -->
        <div class="nav-item px-3">
            <div class="nav-link nav-group-toggle @(_financeExpanded ? "expanded" : "")" @onclick="ToggleFinance" @onclick:stopPropagation="true">
                <span class="bi bi-currency-pound" aria-hidden="true"></span> Finance
                <span class="bi @(_financeExpanded ? "bi-chevron-down" : "bi-chevron-right") nav-chevron" aria-hidden="true"></span>
            </div>
            @if (_financeExpanded)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link nav-link-sub" href="Payments" Match="NavLinkMatch.All">
                        <span class="bi bi-cash-coin" aria-hidden="true"></span> Payments
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts" Match="NavLinkMatch.All">
                        <span class="bi bi-wallet2" aria-hidden="true"></span> Accounts
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts/Budget" Match="NavLinkMatch.All">
                        <span class="bi bi-calculator" aria-hidden="true"></span> Unit Budget
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Inventory" Match="NavLinkMatch.All">
                        <span class="bi bi-box-seam" aria-hidden="true"></span> Inventory
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts/RecordIncome">
                        <span class="bi bi-cash-stack" aria-hidden="true"></span> Record Income
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts/Expenses">
                        <span class="bi bi-receipt" aria-hidden="true"></span> Expenses
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts/Claims">
                        <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Claims
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts/Transactions">
                        <span class="bi bi-journal-text" aria-hidden="true"></span> Transactions
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts/JournalEntry">
                        <span class="bi bi-journal-plus" aria-hidden="true"></span> Journal Entry
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts/Reconciliation">
                        <span class="bi bi-check2-square" aria-hidden="true"></span> Reconciliation
                    </NavLink>
                </div>
            }
        </div>

        <!-- Reports Section (Expandable) -->
        <div class="nav-item px-3">
            <div class="nav-link nav-group-toggle @(_reportsExpanded ? "expanded" : "")" @onclick="ToggleReports" @onclick:stopPropagation="true">
                <span class="bi bi-file-earmark-bar-graph" aria-hidden="true"></span> Reports
                <span class="bi @(_reportsExpanded ? "bi-chevron-down" : "bi-chevron-right") nav-chevron" aria-hidden="true"></span>
            </div>
            @if (_reportsExpanded)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link nav-link-sub" href="Meetings/Register" Match="NavLinkMatch.All">
                        <span class="bi bi-grid-3x3-gap" aria-hidden="true"></span> Term Register
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Meetings/Alerts">
                        <span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Attendance Alerts
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Meetings/Timetable">
                        <span class="bi bi-calendar-week" aria-hidden="true"></span> Timetable
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Payments/Overdue">
                        <span class="bi bi-exclamation-triangle-fill" aria-hidden="true"></span> Overdue Payments
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Reports/YearEndAccounts">
                        <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Year End Accounts
                    </NavLink>
                </div>
            }
        </div>

        <!-- Configuration Section (Expandable) -->
        <div class="nav-item px-3">
            <div class="nav-link nav-group-toggle @(_configExpanded ? "expanded" : "")" @onclick="ToggleConfig" @onclick:stopPropagation="true">
                <span class="bi bi-gear" aria-hidden="true"></span> Configuration
                <span class="bi @(_configExpanded ? "bi-chevron-down" : "bi-chevron-right") nav-chevron" aria-hidden="true"></span>
            </div>
            @if (_configExpanded)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link nav-link-sub" href="Configuration/Terms">
                        <span class="bi bi-calendar-event" aria-hidden="true"></span> Term Dates
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Configuration/Settings">
                        <span class="bi bi-sliders" aria-hidden="true"></span> Unit Settings
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Configuration/Users">
                        <span class="bi bi-people" aria-hidden="true"></span> Users
                    </NavLink>
                    <NavLink class="nav-link nav-link-sub" href="Accounts/Manage">
                        <span class="bi bi-bank" aria-hidden="true"></span> Manage Accounts
                    </NavLink>
                </div>
            }
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Logout">
                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Logout
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool _programmeExpanded = false;
    private bool _financeExpanded = false;
    private bool _reportsExpanded = false;
    private bool _configExpanded = false;

    private void ToggleProgramme()
    {
        _programmeExpanded = !_programmeExpanded;
    }

    private void ToggleFinance()
    {
        _financeExpanded = !_financeExpanded;
    }

    private void ToggleReports()
    {
        _reportsExpanded = !_reportsExpanded;
    }

    private void ToggleConfig()
    {
        _configExpanded = !_configExpanded;
    }
}