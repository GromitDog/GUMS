@page "/Accounts/Reconciliation"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Bank Reconciliation - GUMS</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-check2-square"></i> Bank Reconciliation</h2>
        <a href="/Accounts" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Accounts
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading reconciliation data...</p>
        </div>
    }
    else if (_currentReconciliation != null)
    {
        <!-- Active Reconciliation Workspace -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-pencil-square"></i> Reconciliation in Progress
                    <small class="ms-2">Statement Date: @_currentReconciliation.StatementDate.ToString("dd MMM yyyy")</small>
                </h5>
            </div>
            <div class="card-body">
                <!-- Summary Panel -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Last Reconciled Balance</h6>
                                <h4 class="mb-0">@_summary.LastReconciledBalance.ToString("C")</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Cleared Items Total</h6>
                                <h4 class="mb-0">@_summary.ClearedItemsTotal.ToString("C")</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Cleared Balance</h6>
                                <h4 class="mb-0">@_summary.ClearedBalance.ToString("C")</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100 @(_summary.Difference == 0 ? "border-success" : "border-danger")">
                            <div class="card-body text-center">
                                <h6 class="text-muted mb-2">Difference</h6>
                                <h4 class="mb-0 @(_summary.Difference == 0 ? "text-success" : "text-danger")">
                                    @_summary.Difference.ToString("C")
                                </h4>
                                @if (_summary.Difference == 0)
                                {
                                    <small class="text-success"><i class="bi bi-check-circle-fill"></i> Balanced</small>
                                }
                                else
                                {
                                    <small class="text-danger">Statement: @_summary.StatementBalance.ToString("C")</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between mb-3">
                    <div>
                        @if (_showAbandonConfirm)
                        {
                            <span class="me-2 text-danger">Are you sure? This will unclear all lines.</span>
                            <button class="btn btn-danger me-2" @onclick="AbandonReconciliation" disabled="@_isSaving">
                                <i class="bi bi-trash"></i> Yes, Abandon
                            </button>
                            <button class="btn btn-secondary" @onclick="() => _showAbandonConfirm = false">
                                Cancel
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger" @onclick="() => _showAbandonConfirm = true">
                                <i class="bi bi-x-circle"></i> Abandon
                            </button>
                        }
                    </div>
                    <button class="btn btn-success" @onclick="CompleteReconciliation"
                            disabled="@(_summary.Difference != 0 || _isSaving)">
                        <i class="bi bi-check-lg"></i> Complete Reconciliation
                    </button>
                </div>

                <!-- Transaction Lines Table -->
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 50px;">
                                    <i class="bi bi-check2-square"></i>
                                </th>
                                <th>Date</th>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in _lines)
                            {
                                <tr class="@(line.IsCleared ? "table-success" : "")" style="cursor: pointer;"
                                    @onclick="() => ToggleLine(line.TransactionLineId)">
                                    <td>
                                        <input type="checkbox" class="form-check-input" checked="@line.IsCleared"
                                               @onclick:stopPropagation="true"
                                               @onchange="() => ToggleLine(line.TransactionLineId)" />
                                    </td>
                                    <td>@line.Date.ToString("dd MMM yyyy")</td>
                                    <td>@line.Description</td>
                                    <td class="text-end @(line.Amount >= 0 ? "text-success" : "text-danger")">
                                        @line.Amount.ToString("C")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!_lines.Any())
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-inbox"></i> No unreconciled bank transactions found.
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- No Active Reconciliation - Start New -->
        <div class="row">
            <div class="col-md-8">
                <!-- Info Card -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Bank Account Status</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-muted">Current Book Balance</h6>
                                <h3>@_currentBookBalance.ToString("C")</h3>
                            </div>
                            <div class="col-md-6">
                                @if (_lastCompleted != null)
                                {
                                    <h6 class="text-muted">Last Reconciled</h6>
                                    <h3>@_lastCompleted.ReconciledBookBalance?.ToString("C")</h3>
                                    <small class="text-muted">
                                        @_lastCompleted.StatementDate.ToString("dd MMM yyyy")
                                    </small>
                                }
                                else
                                {
                                    <h6 class="text-muted">Last Reconciled</h6>
                                    <p class="text-muted">No previous reconciliations</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Start New Reconciliation Form -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Start New Reconciliation</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Statement Date</label>
                                <input type="date" class="form-control" @bind="_statementDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Statement Balance</label>
                                <div class="input-group">
                                    <span class="input-group-text">&pound;</span>
                                    <input type="number" class="form-control" step="0.01"
                                           @bind="_statementBalance" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Notes (optional)</label>
                                <input type="text" class="form-control" maxlength="500"
                                       @bind="_notes" placeholder="e.g. March statement" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-primary" @onclick="StartReconciliation" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                <i class="bi bi-play-fill"></i> Start Reconciliation
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- History -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Reconciliation History</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (_history.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var rec in _history)
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@rec.StatementDate.ToString("dd MMM yyyy")</strong>
                                                @if (!string.IsNullOrEmpty(rec.Notes))
                                                {
                                                    <br /><small class="text-muted">@rec.Notes</small>
                                                }
                                            </div>
                                            <span class="badge bg-success">
                                                @rec.ReconciledBookBalance?.ToString("C")
                                            </span>
                                        </div>
                                        <small class="text-muted">
                                            Completed: @rec.CompletedDate?.ToString("dd MMM yyyy HH:mm")
                                        </small>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">
                                <i class="bi bi-inbox"></i> No reconciliation history yet.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
