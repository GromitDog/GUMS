@page "/Accounts/EventAccounts/{MeetingId:int}"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Event Accounts - GUMS</PageTitle>

<style>
    .event-accounts { max-width: 1200px; margin: 0 auto; }

    .event-accounts .page-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        padding-bottom: 1rem;
        margin-bottom: 1.75rem;
        border-bottom: 1px solid #e5e7eb;
    }
    .event-accounts .page-head .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--gg-muted);
        margin-bottom: 0.25rem;
    }
    .event-accounts .page-head h2 {
        margin: 0;
        font-size: 1.6rem;
        color: var(--gg-dark-navy);
    }
    .event-accounts .page-head .head-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .event-accounts .head-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        color: var(--gg-dark-navy);
        background: #f3f4f6;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }
    .event-accounts .head-link:hover { background: var(--gg-primary-blue); color: white; }

    .event-accounts .tiles {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }
    .event-accounts .tile {
        position: relative;
        padding: 1rem 1.1rem 1.1rem;
        background: white;
        border-radius: 10px;
        box-shadow: 0 1px 2px rgba(22, 27, 78, 0.06), 0 1px 3px rgba(22, 27, 78, 0.04);
        overflow: hidden;
    }
    .event-accounts .tile::before {
        content: "";
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 4px;
        background: var(--gg-primary-blue);
    }
    .event-accounts .tile.accent-success::before { background: var(--gg-success); }
    .event-accounts .tile.accent-danger::before { background: var(--gg-error); }
    .event-accounts .tile.accent-warning::before { background: var(--gg-theme-take-action); }
    .event-accounts .tile-label {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--gg-muted);
        margin: 0 0 0.3rem;
        font-weight: 500;
    }
    .event-accounts .tile-value {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--gg-dark-navy);
        margin: 0;
        line-height: 1.1;
    }
    .event-accounts .tile-value.income { color: var(--gg-success); }
    .event-accounts .tile-value.expense { color: var(--gg-error); }
    .event-accounts .tile-value.outstanding { color: var(--gg-theme-take-action); }
    .event-accounts .tile-sub { font-size: 0.78rem; color: var(--gg-muted); margin-top: 0.3rem; }

    .event-accounts .net-position {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 0.9rem 1.25rem;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--gg-dark-navy), #1f2559);
        color: white;
        margin-bottom: 2rem;
    }
    .event-accounts .net-position .label {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.78rem;
        opacity: 0.8;
    }
    .event-accounts .net-position .value { font-size: 1.6rem; font-weight: 700; }
    .event-accounts .net-position .value.positive { color: #7fe59b; }
    .event-accounts .net-position .value.negative { color: #ff9a9a; }

    .event-accounts .panel { margin-bottom: 1.75rem; }
    .event-accounts .panel-heading {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding-bottom: 0.5rem;
        margin-bottom: 0.9rem;
        border-bottom: 2px solid var(--gg-primary-blue);
    }
    .event-accounts .panel-heading.income { border-bottom-color: var(--gg-success); }
    .event-accounts .panel-heading.expense { border-bottom-color: var(--gg-error); }
    .event-accounts .panel-heading h5 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--gg-dark-navy);
    }
    .event-accounts .panel-heading .accent-dot {
        display: inline-block;
        width: 10px; height: 10px;
        border-radius: 50%;
        background: var(--gg-primary-blue);
    }
    .event-accounts .panel-heading.income .accent-dot { background: var(--gg-success); }
    .event-accounts .panel-heading.expense .accent-dot { background: var(--gg-error); }
    .event-accounts .panel-empty {
        padding: 1.5rem 1rem;
        text-align: center;
        color: var(--gg-muted);
        font-style: italic;
    }

    .event-accounts table.ledger {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    .event-accounts table.ledger thead th {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--gg-muted);
        font-weight: 600;
        padding: 0.5rem 0.6rem;
        border-bottom: 1px solid #e5e7eb;
        text-align: left;
    }
    .event-accounts table.ledger thead th.num { text-align: right; }
    .event-accounts table.ledger tbody td {
        padding: 0.55rem 0.6rem;
        border-bottom: 1px solid #f3f4f6;
        vertical-align: middle;
    }
    .event-accounts table.ledger tbody tr:hover td { background: #fafbfc; }
    .event-accounts table.ledger td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .event-accounts table.ledger tfoot td {
        padding: 0.6rem;
        font-weight: 600;
        border-top: 2px solid #e5e7eb;
    }
    .event-accounts .muted { color: var(--gg-muted); }
    .event-accounts .credit-amt { color: var(--gg-theme-take-action); font-weight: 600; }
    .event-accounts .outstanding-amt { color: var(--gg-error); }

    .event-accounts .link-panel {
        margin-top: 1rem;
        padding: 1rem 1.1rem;
        background: #f9fafb;
        border-radius: 10px;
        border: 1px dashed #d1d5db;
    }
    .event-accounts .link-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .event-accounts .link-panel-head h6 { margin: 0; font-size: 0.95rem; color: var(--gg-dark-navy); }
    .event-accounts .link-toggle {
        background: none;
        border: none;
        color: var(--gg-primary-blue);
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        padding: 0;
    }
    .event-accounts .link-toggle:hover { color: var(--gg-dark-navy); text-decoration: underline; }

    .event-accounts .inline-alert {
        padding: 0.7rem 1rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .event-accounts .inline-alert.success {
        background: rgba(38, 176, 80, 0.1);
        color: var(--gg-dark-navy);
        border-left: 3px solid var(--gg-success);
    }
    .event-accounts .inline-alert.error {
        background: rgba(229, 0, 0, 0.08);
        color: var(--gg-dark-navy);
        border-left: 3px solid var(--gg-error);
    }
    .event-accounts .inline-alert .close-btn {
        margin-left: auto;
        background: none; border: none;
        color: var(--gg-muted);
        cursor: pointer;
        font-size: 1.1rem;
        line-height: 1;
    }

    .event-accounts .state-badge {
        display: inline-block;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.02em;
    }
    .event-accounts .state-badge.refunded {
        background: #e5e7eb;
        color: #4b5563;
    }
</style>

<div class="container-fluid py-4">
    <div class="event-accounts">

        @if (_isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (_summary == null)
        {
            <div class="inline-alert error">
                <i class="bi bi-exclamation-triangle-fill"></i> Event not found.
            </div>
        }
        else
        {
            <div class="page-head">
                <div>
                    <p class="eyebrow">Event accounts</p>
                    <h2>@_summary.MeetingTitle</h2>
                </div>
                <div class="head-actions">
                    <a href="/Accounts/EventBudget/@MeetingId" class="head-link">
                        <i class="bi bi-calculator"></i> Budget
                    </a>
                    <a href="/Accounts/BudgetComparison/@MeetingId" class="head-link">
                        <i class="bi bi-bar-chart"></i> Budget vs Actual
                    </a>
                    <a href="/Meetings/View/@MeetingId" class="head-link">
                        <i class="bi bi-arrow-left"></i> Back to event
                    </a>
                </div>
            </div>

            <div class="tiles">
                <div class="tile accent-success">
                    <p class="tile-label">Total received</p>
                    <p class="tile-value income">@((_summary.TotalIncome + _summary.TotalCreditApplied).ToString("C"))</p>
                    @if (_summary.TotalCreditApplied > 0)
                    {
                        <p class="tile-sub">incl. @_summary.TotalCreditApplied.ToString("C") credit</p>
                    }
                </div>
                <div class="tile">
                    <p class="tile-label">Cash received</p>
                    <p class="tile-value">@_summary.TotalIncome.ToString("C")</p>
                    <p class="tile-sub">@_summary.PaidCount of @_summary.PaymentCount paid</p>
                </div>
                <div class="tile accent-danger">
                    <p class="tile-label">Total expenses</p>
                    <p class="tile-value expense">@_summary.TotalExpenses.ToString("C")</p>
                </div>
                <div class="tile @(_summary.TotalOutstanding > 0 ? "accent-warning" : "accent-success")">
                    <p class="tile-label">Outstanding</p>
                    @if (_summary.TotalOutstanding > 0)
                    {
                        <p class="tile-value outstanding">@_summary.TotalOutstanding.ToString("C")</p>
                        <p class="tile-sub">@_summary.PendingCount pending</p>
                    }
                    else
                    {
                        <p class="tile-value income">@(0m.ToString("C"))</p>
                        <p class="tile-sub"><i class="bi bi-check-circle"></i> All settled</p>
                    }
                </div>
            </div>

            <div class="net-position">
                <span class="label">Net position</span>
                <span class="value @(_summary.NetPosition >= 0 ? "positive" : "negative")">
                    @_summary.NetPosition.ToString("C")
                </span>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="panel">
                        <div class="panel-heading income">
                            <span class="accent-dot"></span>
                            <h5>Payments</h5>
                        </div>
                        @if (!_summary.IncomeBreakdown.Any())
                        {
                            <div class="panel-empty">No payments recorded for this event.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="ledger">
                                    <thead>
                                        <tr>
                                            <th>Member</th>
                                            <th class="num d-none d-md-table-cell">Due</th>
                                            <th class="num">Paid</th>
                                            <th class="num">Credit</th>
                                            <th class="num d-none d-md-table-cell">Outstanding</th>
                                            <th>Status</th>
                                            <th class="d-none d-lg-table-cell">Method</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _summary.IncomeBreakdown)
                                        {
                                            <tr>
                                                <td>@item.Description</td>
                                                <td class="num d-none d-md-table-cell">@item.Amount.ToString("C")</td>
                                                <td class="num">
                                                    @if (item.AmountPaid > 0)
                                                    {
                                                        @item.AmountPaid.ToString("C")
                                                    }
                                                    else
                                                    {
                                                        <span class="muted">—</span>
                                                    }
                                                </td>
                                                <td class="num">
                                                    @if (item.CreditApplied > 0)
                                                    {
                                                        <span class="credit-amt">@item.CreditApplied.ToString("C")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="muted">—</span>
                                                    }
                                                </td>
                                                <td class="num d-none d-md-table-cell">
                                                    @if (item.Outstanding > 0)
                                                    {
                                                        <span class="outstanding-amt">@item.Outstanding.ToString("C")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="muted">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.Status == PaymentStatus.Paid)
                                                    {
                                                        <span class="badge badge-gg-paid">Paid</span>
                                                    }
                                                    else if (item.Status == PaymentStatus.Pending)
                                                    {
                                                        <span class="badge badge-gg-pending">Pending</span>
                                                    }
                                                    else if (item.Status == PaymentStatus.Refunded)
                                                    {
                                                        <span class="state-badge refunded">Refunded</span>
                                                    }
                                                </td>
                                                <td class="d-none d-lg-table-cell muted">
                                                    @if (item.PaymentMethod.HasValue)
                                                    {
                                                        @FormatPaymentMethod(item.PaymentMethod.Value)
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td>Total</td>
                                            <td class="num d-none d-md-table-cell">@_summary.TotalAmountDue.ToString("C")</td>
                                            <td class="num">@_summary.TotalIncome.ToString("C")</td>
                                            <td class="num">
                                                @if (_summary.TotalCreditApplied > 0)
                                                {
                                                    <span class="credit-amt">@_summary.TotalCreditApplied.ToString("C")</span>
                                                }
                                                else
                                                {
                                                    <span class="muted">—</span>
                                                }
                                            </td>
                                            <td class="num d-none d-md-table-cell">
                                                @if (_summary.TotalOutstanding > 0)
                                                {
                                                    <span class="outstanding-amt">@_summary.TotalOutstanding.ToString("C")</span>
                                                }
                                                else
                                                {
                                                    <span class="muted">—</span>
                                                }
                                            </td>
                                            <td colspan="2"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="panel">
                        <div class="panel-heading expense">
                            <span class="accent-dot"></span>
                            <h5>Expenses</h5>
                        </div>
                        @if (!_summary.ExpenseBreakdown.Any())
                        {
                            <div class="panel-empty">No expenses recorded for this event.</div>
                        }
                        else
                        {
                            <table class="ledger">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="num">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _summary.ExpenseBreakdown)
                                    {
                                        <tr>
                                            <td>@item.CategoryName</td>
                                            <td class="num">@item.Amount.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>Total</td>
                                        <td class="num">@_summary.TotalExpenses.ToString("C")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_linkSuccess))
            {
                <div class="inline-alert success">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@_linkSuccess</span>
                    <button type="button" class="close-btn" @onclick="() => _linkSuccess = string.Empty">&times;</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_linkError))
            {
                <div class="inline-alert error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@_linkError</span>
                    <button type="button" class="close-btn" @onclick="() => _linkError = string.Empty">&times;</button>
                </div>
            }

            @if (_unlinkedPayments.Any())
            {
                <div class="link-panel">
                    <div class="link-panel-head">
                        <h6><i class="bi bi-link-45deg"></i> Link existing payments to this event</h6>
                        <button class="link-toggle" @onclick="ToggleLinkPanel">
                            @(_showLinkPanel ? "Hide" : $"Show {_unlinkedPayments.Count} unlinked payment{(_unlinkedPayments.Count != 1 ? "s" : "")}")
                        </button>
                    </div>
                    @if (_showLinkPanel)
                    {
                        <div class="mt-3">
                            <p class="muted small mb-3">These paid one-off payments aren't linked to any event. Tick the ones that belong to this event and click Link.</p>
                            <div class="table-responsive">
                                <table class="ledger">
                                    <thead>
                                        <tr>
                                            <th style="width:2rem;"></th>
                                            <th class="d-none d-md-table-cell">Reference</th>
                                            <th>Member</th>
                                            <th class="num">Amount paid</th>
                                            <th class="d-none d-md-table-cell">Date paid</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in _unlinkedPayments)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@_selectedPaymentIds.Contains(p.Id)"
                                                           @onchange="() => TogglePayment(p.Id)" />
                                                </td>
                                                <td class="d-none d-md-table-cell">@p.Reference</td>
                                                <td>@p.MembershipNumber</td>
                                                <td class="num">@p.AmountPaid.ToString("C")</td>
                                                <td class="d-none d-md-table-cell muted">@(p.PaymentDate?.ToString("d MMM yyyy") ?? "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <button class="btn btn-primary mt-3" @onclick="LinkSelectedPayments"
                                    disabled="@(!_selectedPaymentIds.Any() || _isLinking)">
                                <i class="bi bi-link-45deg"></i> Link selected (@_selectedPaymentIds.Count)
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>
