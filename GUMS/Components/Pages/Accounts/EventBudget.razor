@page "/Accounts/EventBudget/{MeetingId:int}"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Event Budget - GUMS</PageTitle>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Accounts">Accounts</a></li>
            <li class="breadcrumb-item active">Event Budget</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = string.Empty"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_meeting == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i> Meeting not found.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>@_meeting.Title - Budget</h2>
            <div>
                <a href="/Accounts/BudgetComparison/@MeetingId" class="btn btn-outline-primary me-2">
                    <i class="bi bi-bar-chart"></i> Budget vs Actual
                </a>
                <a href="/Meetings/View/@MeetingId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Meeting
                </a>
            </div>
        </div>

        @if (_budget == null)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-calculator" style="font-size: 3rem; color: var(--gg-muted);"></i>
                    <p class="text-muted mt-3 mb-3">No budget has been created for this event yet.</p>
                    <button class="btn btn-primary" @onclick="CreateBudget">
                        <i class="bi bi-plus-circle"></i> Create Budget
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Cost & Income Projections -->
            @if (_estimate != null)
            {
                <div class="card mb-4">
                    <div class="card-header" style="background-color: var(--gg-dark-navy); color: white;">
                        <h5 class="mb-0 text-white"><i class="bi bi-graph-up-arrow"></i> Cost &amp; Income Projections</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 align-items-end mb-3">
                            <div class="col-md-5">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="leadersPaySwitch"
                                           @bind="_leadersPay" @bind:after="RecalculateAsync" />
                                    <label class="form-check-label" for="leadersPaySwitch">
                                        <strong>Leaders pay towards this event</strong>
                                    </label>
                                </div>
                                <small class="text-muted">
                                    @if (_leadersPay)
                                    {
                                        <span>Costs are shared &mdash; each girl and adult pays their own way.</span>
                                    }
                                    else
                                    {
                                        <span>Leaders go free &mdash; the girls cover the adults' costs too.</span>
                                    }
                                </small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label mb-1">Adults attending</label>
                                <input type="number" class="form-control" min="0" step="1"
                                       @bind="_adultCount" @bind:after="RecalculateAsync" />
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block">
                                    <i class="bi bi-people"></i> @_estimate.GirlCount girls on the roll,
                                    @_estimate.ActiveLeaderCount active @(_estimate.ActiveLeaderCount == 1 ? "leader" : "leaders")
                                </small>
                                <small class="text-muted d-block">
                                    <i class="bi bi-cash"></i>
                                    @if (_estimate.HasCharge)
                                    {
                                        <span>
                                            Charging @((_estimate.CostPerAttendee ?? 0).ToString("C"))/girl@(_leadersPay && (_estimate.CostPerLeader ?? 0) > 0 ? $", {(_estimate.CostPerLeader ?? 0):C}/leader" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>No charge set &mdash; <a href="/Meetings/Edit/@MeetingId">set a cost on the event</a> to project income.</span>
                                    }
                                </small>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-1">
                                <thead>
                                    <tr>
                                        <th>Attendance</th>
                                        <th class="text-end">Girls</th>
                                        <th class="text-end">Adults</th>
                                        <th class="text-end">Total cost</th>
                                        <th class="text-end">Cost / girl</th>
                                        <th class="text-end">Cost / adult</th>
                                        @if (_estimate.HasCharge)
                                        {
                                            <th class="text-end">Projected income</th>
                                            <th class="text-end">Surplus / (shortfall)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in _estimate.Scenarios)
                                    {
                                        <tr>
                                            <td>@s.Label</td>
                                            <td class="text-end">@s.Girls</td>
                                            <td class="text-end">@s.Adults</td>
                                            <td class="text-end">@s.TotalCost.ToString("C")</td>
                                            <td class="text-end fw-bold">@s.CostPerGirl.ToString("C")</td>
                                            <td class="text-end">
                                                @if (_leadersPay)
                                                {
                                                    <span>@s.CostPerAdult.ToString("C")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" title="Covered by the girls">&mdash;</span>
                                                }
                                            </td>
                                            @if (_estimate.HasCharge)
                                            {
                                                <td class="text-end">@s.ProjectedIncome.ToString("C")</td>
                                                <td class="text-end">
                                                    <span class="@(s.Surplus >= 0 ? "text-success" : "text-danger")">
                                                        @s.Surplus.ToString("C")
                                                    </span>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i>
                            <strong>Cost / girl</strong> and <strong>cost / adult</strong> are the break-even charges needed to
                            recover the total cost. Fixed costs are split evenly across every head.
                        </small>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-lg-8">
                    <!-- Budget Items -->
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--gg-primary-blue); color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-list-ul"></i> Budget Items
                            </h5>
                            <button class="btn btn-sm btn-light" @onclick="ShowAddItem">
                                <i class="bi bi-plus-circle"></i> Add Item
                            </button>
                        </div>
                        <div class="card-body">
                            @if (!_budget.Items.Any())
                            {
                                <p class="text-muted text-center py-3">No budget items yet. Add items to start planning costs.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Description</th>
                                                <th>Type</th>
                                                <th class="text-end">Amount</th>
                                                <th>Status</th>
                                                <th>Category</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in _budget.Items)
                                            {
                                                <tr>
                                                    <td>@item.Description</td>
                                                    <td>
                                                        <span class="badge @GetCostTypeBadgeClass(item.CostType)">
                                                            @GetCostTypeLabel(item.CostType)
                                                        </span>
                                                    </td>
                                                    <td class="text-end">@item.Amount.ToString("C")</td>
                                                    <td>
                                                        <span class="badge @(item.CostStatus == BudgetCostStatus.Confirmed ? "bg-success" : "bg-warning")">
                                                            @item.CostStatus
                                                        </span>
                                                    </td>
                                                    <td>@(item.ExpenseAccount?.Name ?? "-")</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditItem(item)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(item.Id)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (_showItemForm)
                            {
                                <hr />
                                <h6>@(_editingItemId.HasValue ? "Edit" : "Add") Budget Item</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Description</label>
                                        <input type="text" class="form-control" @bind="_itemDescription" maxlength="200" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Cost Type</label>
                                        <select class="form-select" @bind="_itemCostType">
                                            <option value="@BudgetCostType.PerGirl">Per Girl</option>
                                            <option value="@BudgetCostType.PerAdult">Per Adult</option>
                                            <option value="@BudgetCostType.PerPerson">Per Person (all)</option>
                                            <option value="@BudgetCostType.FixedTotal">Fixed Total</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Amount</label>
                                        <div class="input-group">
                                            <span class="input-group-text">£</span>
                                            <input type="number" class="form-control" @bind="_itemAmount" step="0.01" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Status</label>
                                        <select class="form-select" @bind="_itemCostStatus">
                                            <option value="@BudgetCostStatus.Estimate">Estimate</option>
                                            <option value="@BudgetCostStatus.Confirmed">Confirmed</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Expense Category</label>
                                        <select class="form-select" @bind="_itemExpenseAccountId">
                                            <option value="">-- None --</option>
                                            @foreach (var account in _expenseAccounts)
                                            {
                                                <option value="@account.Id">@account.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end gap-2">
                                        <button class="btn btn-primary" @onclick="SaveItem">
                                            <i class="bi bi-check-lg"></i> Save
                                        </button>
                                        <button class="btn btn-secondary" @onclick="CancelItemForm">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Notes -->
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title"><i class="bi bi-sticky"></i> Notes</h6>
                            <textarea class="form-control" rows="3" @bind="_budgetNotes" placeholder="Budget notes..."></textarea>
                            <button class="btn btn-sm btn-outline-primary mt-2" @onclick="SaveNotes">
                                Save Notes
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
