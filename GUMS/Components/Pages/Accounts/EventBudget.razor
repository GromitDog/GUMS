@page "/Accounts/EventBudget/{MeetingId:int}"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Event Budget - GUMS</PageTitle>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Accounts">Accounts</a></li>
            <li class="breadcrumb-item active">Event Budget</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = string.Empty"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_meeting == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i> Meeting not found.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>@_meeting.Title - Budget</h2>
            <div>
                <a href="/Accounts/BudgetComparison/@MeetingId" class="btn btn-outline-primary me-2">
                    <i class="bi bi-bar-chart"></i> Budget vs Actual
                </a>
                <a href="/Meetings/View/@MeetingId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Meeting
                </a>
            </div>
        </div>

        @if (_budget == null)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-calculator" style="font-size: 3rem; color: var(--gg-muted);"></i>
                    <p class="text-muted mt-3 mb-3">No budget has been created for this event yet.</p>
                    <button class="btn btn-primary" @onclick="CreateBudget">
                        <i class="bi bi-plus-circle"></i> Create Budget
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Cost & Income Planner -->
            @if (_estimate != null)
            {
                var plan = Plan!;
                var pct = _estimate.GirlCount > 0 ? (int)Math.Round(100.0 * _girls / _estimate.GirlCount) : 0;
                <div class="card mb-4">
                    <div class="card-header" style="background-color: var(--gg-dark-navy); color: white;">
                        <h5 class="mb-0 text-white"><i class="bi bi-sliders"></i> Cost &amp; Income Planner</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <!-- Controls -->
                            <div class="col-lg-7">
                                <label class="form-label mb-1">
                                    <strong>Turnout:</strong> @_girls of @_estimate.GirlCount girls (@pct%)
                                </label>
                                <input type="range" class="form-range" min="0" max="@_estimate.GirlCount" step="1"
                                       @bind="_girls" @bind:event="oninput" />

                                <div class="row g-3 mt-1 align-items-end">
                                    <div class="col-sm-5">
                                        <label class="form-label mb-1">Adults attending</label>
                                        <input type="number" class="form-control" min="0" step="1"
                                               @bind="_adults" @bind:event="oninput" />
                                    </div>
                                    <div class="col-sm-7">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="leadersPaySwitch"
                                                   @bind="_leadersPay" />
                                            <label class="form-check-label" for="leadersPaySwitch">
                                                Leaders pay their way
                                            </label>
                                        </div>
                                        <small class="text-muted">
                                            @(_leadersPay ? "Adults are charged too." : "Girls cover the adults' costs.")
                                        </small>
                                    </div>
                                </div>

                                <hr />

                                <label class="form-label mb-2"><strong>What we'll charge</strong></label>
                                <div class="row g-3">
                                    <div class="col-sm-5">
                                        <label class="form-label mb-1 small text-muted">Per girl</label>
                                        <div class="input-group">
                                            <span class="input-group-text">£</span>
                                            <input type="number" class="form-control" min="0" step="0.01"
                                                   @bind="_chargePerGirl" @bind:event="oninput" />
                                        </div>
                                    </div>
                                    @if (_leadersPay)
                                    {
                                        <div class="col-sm-5">
                                            <label class="form-label mb-1 small text-muted">Per adult</label>
                                            <div class="input-group">
                                                <span class="input-group-text">£</span>
                                                <input type="number" class="form-control" min="0" step="0.01"
                                                       @bind="_chargePerAdult" @bind:event="oninput" />
                                            </div>
                                        </div>
                                    }
                                </div>
                                <button class="btn btn-primary mt-3" @onclick="SaveChargesAsync">
                                    <i class="bi bi-save"></i> Save charges to event
                                </button>
                                <small class="d-block text-muted mt-1">
                                    Writes @_chargePerGirl.ToString("C")/girl@(_leadersPay ? $" and {_chargePerAdult:C}/adult" : "") to the event so payments can be raised.
                                </small>
                            </div>

                            <!-- Live balance -->
                            <div class="col-lg-5">
                                <div class="p-3 rounded h-100" style="background-color: var(--gg-light, #f5f7fa);">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Total cost</span>
                                        <strong>@plan.TotalCost.ToString("C")</strong>
                                    </div>
                                    @if (plan.OtherIncome > 0)
                                    {
                                        <div class="d-flex justify-content-between mb-1 text-success">
                                            <span>Grants &amp; fundraising</span>
                                            <span>+@plan.OtherIncome.ToString("C")</span>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>From charges</span>
                                        <span>+@plan.ChargeIncome.ToString("C")</span>
                                    </div>
                                    <hr class="my-2" />
                                    <div class="d-flex justify-content-between">
                                        <span>Total income</span>
                                        <strong>@plan.TotalIncome.ToString("C")</strong>
                                    </div>

                                    <div class="text-center mt-3 p-2 rounded"
                                         style="background-color: @(plan.IsBalanced ? "var(--gg-success)" : plan.Balance > 0 ? "var(--gg-success)" : "var(--gg-error)"); color: white;">
                                        @if (plan.IsBalanced)
                                        {
                                            <div><i class="bi bi-check-circle-fill"></i> <strong>Balanced</strong></div>
                                        }
                                        else if (plan.Balance > 0)
                                        {
                                            <div><strong>Surplus of @plan.Balance.ToString("C")</strong></div>
                                            <small>Income exceeds cost</small>
                                        }
                                        else
                                        {
                                            <div><strong>Shortfall of @((-plan.Balance).ToString("C"))</strong></div>
                                            <small>Income doesn't cover cost</small>
                                        }
                                    </div>

                                    @if (!plan.IsBalanced && _girls > 0)
                                    {
                                        <div class="mt-3 border-top pt-2 small">
                                            <div class="mb-1">
                                                <i class="bi bi-lightbulb"></i> To break even, charge
                                                <strong>@plan.RecommendedPerGirl.ToString("C")</strong>/girl@(_leadersPay && plan.RecommendedPerAdult > 0 ? $" and {plan.RecommendedPerAdult:C}/adult" : "").
                                            </div>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="ApplyRecommendation">
                                                Use recommended
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-lg-8">
                    <!-- Budget Items -->
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--gg-primary-blue); color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-list-ul"></i> Budget Items
                            </h5>
                            <button class="btn btn-sm btn-light" @onclick="ShowAddItem">
                                <i class="bi bi-plus-circle"></i> Add Item
                            </button>
                        </div>
                        <div class="card-body">
                            @if (!_budget.Items.Any())
                            {
                                <p class="text-muted text-center py-3">No budget items yet. Add items to start planning costs.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Description</th>
                                                <th>Type</th>
                                                <th class="text-end">Amount</th>
                                                <th>Status</th>
                                                <th>Category</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in _budget.Items)
                                            {
                                                <tr>
                                                    <td>@item.Description</td>
                                                    <td>
                                                        <span class="badge @GetCostTypeBadgeClass(item.CostType)">
                                                            @GetCostTypeLabel(item.CostType)
                                                        </span>
                                                    </td>
                                                    <td class="text-end">@item.Amount.ToString("C")</td>
                                                    <td>
                                                        <span class="badge @(item.CostStatus == BudgetCostStatus.Confirmed ? "bg-success" : "bg-warning")">
                                                            @item.CostStatus
                                                        </span>
                                                    </td>
                                                    <td>@(item.ExpenseAccount?.Name ?? "-")</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditItem(item)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(item.Id)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (_showItemForm)
                            {
                                <hr />
                                <h6>@(_editingItemId.HasValue ? "Edit" : "Add") Budget Item</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Description</label>
                                        <input type="text" class="form-control" @bind="_itemDescription" maxlength="200" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Cost Type</label>
                                        <select class="form-select" @bind="_itemCostType">
                                            <option value="@BudgetCostType.PerGirl">Per Girl</option>
                                            <option value="@BudgetCostType.PerAdult">Per Adult</option>
                                            <option value="@BudgetCostType.PerPerson">Per Person (all)</option>
                                            <option value="@BudgetCostType.FixedTotal">Fixed Total</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Amount</label>
                                        <div class="input-group">
                                            <span class="input-group-text">£</span>
                                            <input type="number" class="form-control" @bind="_itemAmount" step="0.01" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Status</label>
                                        <select class="form-select" @bind="_itemCostStatus">
                                            <option value="@BudgetCostStatus.Estimate">Estimate</option>
                                            <option value="@BudgetCostStatus.Confirmed">Confirmed</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Expense Category</label>
                                        <select class="form-select" @bind="_itemExpenseAccountId">
                                            <option value="">-- None --</option>
                                            @foreach (var account in _expenseAccounts)
                                            {
                                                <option value="@account.Id">@account.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end gap-2">
                                        <button class="btn btn-primary" @onclick="SaveItem">
                                            <i class="bi bi-check-lg"></i> Save
                                        </button>
                                        <button class="btn btn-secondary" @onclick="CancelItemForm">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Other Income (grants, fundraising) -->
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--gg-success); color: white;">
                            <h5 class="mb-0"><i class="bi bi-piggy-bank"></i> Other Income</h5>
                            <button class="btn btn-sm btn-light" @onclick="ShowAddIncome">
                                <i class="bi bi-plus-circle"></i> Add Income
                            </button>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">Grants, fundraising or donations towards this event. These reduce what you need to charge.</p>
                            @if (!_budget.IncomeItems.Any())
                            {
                                <p class="text-muted text-center py-2">No grants or fundraising added.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Description</th>
                                                <th class="text-end">Amount</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var income in _budget.IncomeItems)
                                            {
                                                <tr>
                                                    <td>@income.Description</td>
                                                    <td class="text-end">@income.Amount.ToString("C")</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteIncome(income.Id)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="fw-bold" style="border-top: 2px solid var(--gg-dark-navy);">
                                                <td>Total</td>
                                                <td class="text-end">@_budget.IncomeItems.Sum(i => i.Amount).ToString("C")</td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }

                            @if (_showIncomeForm)
                            {
                                <hr />
                                <h6>Add Income</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Description</label>
                                        <input type="text" class="form-control" @bind="_incomeDescription" maxlength="200" placeholder="e.g. District grant" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Amount</label>
                                        <div class="input-group">
                                            <span class="input-group-text">£</span>
                                            <input type="number" class="form-control" @bind="_incomeAmount" step="0.01" min="0" />
                                        </div>
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end gap-2">
                                        <button class="btn btn-primary" @onclick="SaveIncome">
                                            <i class="bi bi-check-lg"></i> Save
                                        </button>
                                        <button class="btn btn-secondary" @onclick="CancelIncomeForm">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Notes -->
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title"><i class="bi bi-sticky"></i> Notes</h6>
                            <textarea class="form-control" rows="3" @bind="_budgetNotes" placeholder="Budget notes..."></textarea>
                            <button class="btn btn-sm btn-outline-primary mt-2" @onclick="SaveNotes">
                                Save Notes
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
