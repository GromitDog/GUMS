@page "/Accounts"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Accounts - GUMS</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Accounts</h2>
        <div class="d-flex gap-2">
            <a href="/Accounts/RecordIncome" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Record Income
            </a>
            <a href="/Accounts/RecordExpense" class="btn btn-warning">
                <i class="bi bi-plus-circle"></i> Record Expense
            </a>
            <a href="/Accounts/BankDeposit" class="btn btn-primary">
                <i class="bi bi-bank"></i> Bank Deposit
            </a>
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" @onclick="ToggleMore" @onclick:stopPropagation="true">
                    More
                </button>
                @if (_showMore)
                {
                    <ul class="dropdown-menu dropdown-menu-end show">
                        <li><a class="dropdown-item" href="/Accounts/Transactions"><i class="bi bi-list-ul me-2"></i>Transaction History</a></li>
                        <li><a class="dropdown-item" href="/Accounts/Expenses"><i class="bi bi-receipt me-2"></i>Expenses</a></li>
                        <li><a class="dropdown-item" href="/Accounts/Claims"><i class="bi bi-file-earmark-text me-2"></i>Claims</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="/Accounts/JournalEntry"><i class="bi bi-journal-plus me-2"></i>Journal Entry</a></li>
                        <li><a class="dropdown-item" href="/Accounts/Reconciliation"><i class="bi bi-check2-square me-2"></i>Reconcile Bank</a></li>
                        <li><a class="dropdown-item" href="/Accounts/Manage"><i class="bi bi-gear me-2"></i>Chart of Accounts</a></li>
                    </ul>
                    <div style="position:fixed;inset:0;z-index:999;" @onclick="CloseMore"></div>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading accounts...</p>
        </div>
    }
    else
    {
        <!-- Asset Accounts -->
        <div class="row mb-4">
            <div class="col-12">
                <h4 class="mb-3">
                    <i class="bi bi-wallet2"></i> Asset Accounts
                </h4>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">Cash on Hand</h6>
                        <h2 class="mb-0" style="color: @(_dashboardStats.CashOnHand >= 0 ? "var(--gg-primary-blue)" : "var(--gg-error)");">
                            @_dashboardStats.CashOnHand.ToString("C")
                        </h2>
                        <small class="text-muted">Physical cash collected</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">Cheques Pending</h6>
                        <h2 class="mb-0" style="color: @(_dashboardStats.ChequesPending >= 0 ? "var(--gg-primary-blue)" : "var(--gg-error)");">
                            @_dashboardStats.ChequesPending.ToString("C")
                        </h2>
                        <small class="text-muted">Cheques to be banked</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">Bank Account</h6>
                        <h2 class="mb-0" style="color: var(--gg-primary-blue);">
                            @_dashboardStats.BankBalance.ToString("C")
                        </h2>
                        <small class="text-muted">Deposited funds</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Assets -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card" style="background-color: var(--gg-primary-blue); color: white;">
                    <div class="card-body text-center py-4">
                        <h5 class="mb-2">Total Assets</h5>
                        <h1 class="mb-0">@_dashboardStats.TotalAssets.ToString("C")</h1>
                    </div>
                </div>
            </div>
        </div>

        <!-- Income This Year -->
        <div class="row mb-4">
            <div class="col-12">
                <h4 class="mb-3">
                    <i class="bi bi-graph-up-arrow"></i> Income This Year
                    <small class="text-muted fs-6 ms-2">@_dashboardStats.FinancialYearStart.ToString("d MMM yyyy") – @_dashboardStats.FinancialYearEnd.ToString("d MMM yyyy")</small>
                </h4>
            </div>
            <div class="col-md-4">
                <div class="card h-100" style="background-color: var(--gg-success); color: white;">
                    <div class="card-body text-center">
                        <h6 class="mb-2">Total Income</h6>
                        <h2 class="mb-0">@_dashboardStats.TotalIncomeThisYear.ToString("C")</h2>
                        <small>All income accounts</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">Subs</h6>
                        <h2 class="mb-0" style="color: var(--gg-success);">@_dashboardStats.SubsIncomeThisYear.ToString("C")</h2>
                        <small class="text-muted">From termly subs</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">Other</h6>
                        <h2 class="mb-0" style="color: var(--gg-success);">@((_dashboardStats.TotalIncomeThisYear - _dashboardStats.SubsIncomeThisYear).ToString("C"))</h2>
                        <small class="text-muted">Events, activities &amp; other</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Expenses This Year -->
        <div class="row mb-4">
            <div class="col-12">
                <h4 class="mb-3">
                    <i class="bi bi-graph-down-arrow"></i> Expenses & Net Position This Year
                </h4>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">Total Expenses</h6>
                        <h2 class="mb-0" style="color: var(--gg-error);">@_dashboardStats.TotalExpensesThisYear.ToString("C")</h2>
                        <small class="text-muted">This year</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100" style="border-color: @(_dashboardStats.NetIncomeThisYear >= 0 ? "var(--gg-success)" : "var(--gg-error)") !important;">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">Net Position</h6>
                        <h2 class="mb-0" style="color: @(_dashboardStats.NetIncomeThisYear >= 0 ? "var(--gg-success)" : "var(--gg-error)");">
                            @_dashboardStats.NetIncomeThisYear.ToString("C")
                        </h2>
                        <small class="text-muted">Income - Expenses</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <h6 class="text-muted mb-2">Pending Claims</h6>
                        <h2 class="mb-0" style="color: @(_dashboardStats.PendingClaimsCount > 0 ? "var(--gg-primary-blue)" : "inherit");">
                            @_dashboardStats.PendingClaimsCount
                        </h2>
                        @if (_dashboardStats.PendingClaimsAmount > 0)
                        {
                            <small class="text-muted">@_dashboardStats.PendingClaimsAmount.ToString("C") outstanding</small>
                        }
                        else
                        {
                            <small class="text-muted">No pending claims</small>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Annual Budget widget (only shown if budget items exist) -->
        @if (_budgetSummary != null)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="mb-1"><i class="bi bi-calculator"></i> Annual Budget</h5>
                            <div class="text-muted small mb-2">@_budgetSummary.YearStart.ToString("d MMM yyyy") – @_budgetSummary.YearEnd.ToString("d MMM yyyy")</div>
                            <div>Budgeted spend: <strong>£@_budgetSummary.TotalAnnualCost.ToString("N2")</strong></div>
                            @if (_budgetSummary.ActualComparison.Any())
                            {
                                <div>Actual spend: <strong>£@_budgetSummary.ActualComparison.Sum(l => l.Actual).ToString("N2")</strong></div>
                            }
                        </div>
                        <div class="text-end">
                            <a href="/Accounts/Budget" class="btn btn-sm btn-outline-primary mb-2">View Budget</a>
                            @if (_budgetSummary.SuggestedTermlySubs > 0)
                            {
                                <div class="text-muted small">Suggested subs</div>
                                <div class="fw-bold fs-5" style="color: var(--gg-dark-navy);">
                                    £@_budgetSummary.SuggestedTermlySubs.ToString("N2")/term
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Quick Actions -->
        @if (_dashboardStats.CashOnHand > 0 || _dashboardStats.ChequesPending > 0)
        {
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    @if (_dashboardStats.CashOnHand > 0 || _dashboardStats.ChequesPending > 0)
                    {
                        <p>You have funds ready to be deposited to the bank.</p>
                        <a href="/Accounts/BankDeposit" class="btn btn-primary">
                            <i class="bi bi-bank"></i> Make a Bank Deposit
                        </a>
                    }
                </div>
            </div>
        }

        <!-- All Accounts Table -->
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-list-check"></i> Chart of Accounts
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in _accounts)
                            {
                                <tr>
                                    <td><code>@account.Code</code></td>
                                    <td>@account.Name</td>
                                    <td>
                                        @switch (account.Type)
                                        {
                                            case AccountType.Asset:
                                                <span class="badge badge-gg-asset">Asset</span>
                                                break;
                                            case AccountType.Liability:
                                                <span class="badge badge-gg-liability">Liability</span>
                                                break;
                                            case AccountType.Equity:
                                                <span class="badge badge-gg-equity">Equity</span>
                                                break;
                                            case AccountType.Income:
                                                <span class="badge badge-gg-income">Income</span>
                                                break;
                                            case AccountType.Expense:
                                                <span class="badge badge-gg-expense">Expense</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <strong style="@(account.Balance < 0 ? "color: var(--gg-error);" : "")">
                                            @account.Balance.ToString("C")
                                        </strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
