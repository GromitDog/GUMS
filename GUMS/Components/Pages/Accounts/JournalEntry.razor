@page "/Accounts/JournalEntry"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Journal Entry - GUMS</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Journal Entry</h2>
        <a href="/Accounts" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Accounts
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = string.Empty"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading accounts...</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-journal-plus"></i> New Journal Entry</h5>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" @bind="_formDate" />
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">Description <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="_formDescription"
                               placeholder="Enter transaction description" />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Account</th>
                                <th style="width: 160px;" class="text-end">Debit</th>
                                <th style="width: 160px;" class="text-end">Credit</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < _lines.Count; i++)
                            {
                                var line = _lines[i];
                                var lineNumber = i + 1;
                                <tr>
                                    <td class="align-middle text-center text-muted">@lineNumber</td>
                                    <td>
                                        <select class="form-select" @bind="line.AccountId">
                                            <option value="0">-- Select Account --</option>
                                            @foreach (var account in _accounts)
                                            {
                                                <option value="@account.Id">@account.Code - @account.Name</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control text-end" step="0.01" min="0"
                                               @bind="line.Debit" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control text-end" step="0.01" min="0"
                                               @bind="line.Credit" />
                                    </td>
                                    <td class="text-center align-middle">
                                        @if (_lines.Count > 2)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(line)"
                                                    title="Remove line">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light fw-bold">
                                <td colspan="2" class="text-end">Totals</td>
                                <td class="text-end">@TotalDebits.ToString("C")</td>
                                <td class="text-end">@TotalCredits.ToString("C")</td>
                                <td class="text-center">
                                    @if (IsBalanced)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Balanced"></i>
                                    }
                                    else if (TotalDebits > 0 || TotalCredits > 0)
                                    {
                                        <i class="bi bi-exclamation-triangle-fill text-warning" title="Not balanced"></i>
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <button class="btn btn-outline-secondary mb-4" @onclick="AddLine">
                    <i class="bi bi-plus-circle"></i> Add Line
                </button>

                @if (!IsBalanced && (TotalDebits > 0 || TotalCredits > 0))
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Debits (@TotalDebits.ToString("C")) must equal credits (@TotalCredits.ToString("C")).
                        Difference: @Math.Abs(TotalDebits - TotalCredits).ToString("C")
                    </div>
                }

                <div class="d-flex justify-content-end">
                    <a href="/Accounts" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button class="btn btn-primary" @onclick="SubmitJournalEntry"
                            disabled="@(!IsFormValid() || _isSubmitting)">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Posting...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>Post Journal Entry</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>
