@page "/Configuration/Settings"
@using GUMS.Data.Enums
@rendermode InteractiveServer

<PageTitle>Unit Settings - GUMS</PageTitle>

<style>
    .toast-fixed {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 9999;
        min-width: 280px;
        max-width: 400px;
        animation: slideInUp 0.25s ease-out;
    }

    @@keyframes slideInUp {
        from { transform: translateY(100%); opacity: 0; }
        to   { transform: translateY(0);   opacity: 1; }
    }
</style>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Unit Settings</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Unit Settings</h2>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }


    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_config != null)
    {
        <div class="row">
            <div class="col-lg-8">
                <EditForm Model="_config" OnValidSubmit="SaveSettings" FormName="unitSettingsForm">
                    <DataAnnotationsValidator />

                    <!-- Unit Details -->
                    <div class="card mb-4">
                        <div class="card-header" style="background-color: var(--gg-primary-blue); color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-house-heart"></i> Unit Details
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Unit Name</label>
                                    <InputText class="form-control" @bind-Value="_config.UnitName" placeholder="e.g. 1st Townsville Brownies" />
                                    <ValidationMessage For="@(() => _config.UnitName)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Unit Type</label>
                                    <InputSelect class="form-select" @bind-Value="_config.UnitType">
                                        <option value="@Section.Rainbow">Rainbows</option>
                                        <option value="@Section.Brownie">Brownies</option>
                                        <option value="@Section.Guide">Guides</option>
                                        <option value="@Section.Ranger">Rangers</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _config.UnitType)" />
                                    <small class="text-muted">All girls in this unit will be part of this section</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Meeting Defaults -->
                    <div class="card mb-4">
                        <div class="card-header" style="background-color: var(--gg-bright-cyan); color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-calendar-week"></i> Default Meeting Settings
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                These settings are used when generating regular meetings for a term.
                            </p>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Meeting Day</label>
                                    <InputSelect class="form-select" @bind-Value="_config.MeetingDayOfWeek">
                                        <option value="@DayOfWeek.Monday">Monday</option>
                                        <option value="@DayOfWeek.Tuesday">Tuesday</option>
                                        <option value="@DayOfWeek.Wednesday">Wednesday</option>
                                        <option value="@DayOfWeek.Thursday">Thursday</option>
                                        <option value="@DayOfWeek.Friday">Friday</option>
                                        <option value="@DayOfWeek.Saturday">Saturday</option>
                                        <option value="@DayOfWeek.Sunday">Sunday</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _config.MeetingDayOfWeek)" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">Start Time</label>
                                    <input type="time" class="form-control"
                                           value="@_config.DefaultMeetingStartTime.ToString("HH:mm")"
                                           @onchange="@(e => _config.DefaultMeetingStartTime = TimeOnly.Parse(e.Value?.ToString() ?? "18:30"))" />
                                    <ValidationMessage For="@(() => _config.DefaultMeetingStartTime)" />
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">End Time</label>
                                    <input type="time" class="form-control"
                                           value="@_config.DefaultMeetingEndTime.ToString("HH:mm")"
                                           @onchange="@(e => _config.DefaultMeetingEndTime = TimeOnly.Parse(e.Value?.ToString() ?? "19:30"))" />
                                    <ValidationMessage For="@(() => _config.DefaultMeetingEndTime)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Default Location Name</label>
                                    <InputText class="form-control" @bind-Value="_config.DefaultLocationName" placeholder="e.g. Village Hall" />
                                    <ValidationMessage For="@(() => _config.DefaultLocationName)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Default Location Address</label>
                                    <InputText class="form-control" @bind-Value="_config.DefaultLocationAddress" placeholder="e.g. 123 Main Street, Town" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Settings -->
                    <div class="card mb-4">
                        <div class="card-header" style="background-color: var(--gg-dark-navy); color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-currency-pound"></i> Payment Settings
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Default Termly Subscription (£)</label>
                                    <InputNumber class="form-control" @bind-Value="_config.DefaultSubsAmount" />
                                    <ValidationMessage For="@(() => _config.DefaultSubsAmount)" />
                                    <small class="text-muted">Default amount for new terms</small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Payment Due Days</label>
                                    <InputNumber class="form-control" @bind-Value="_config.PaymentTermDays" />
                                    <ValidationMessage For="@(() => _config.PaymentTermDays)" />
                                    <small class="text-muted">Days after invoice before payment is overdue</small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Joining Fee (£)</label>
                                    <InputNumber class="form-control" @bind-Value="_config.JoiningFeeAmount" />
                                    <ValidationMessage For="@(() => _config.JoiningFeeAmount)" />
                                    <small class="text-muted">Charged to new members for welcome pack. Set to 0 to disable.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Year Settings -->
                    <div class="card mb-4">
                        <div class="card-header" style="background-color: var(--gg-dark-navy); color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-calendar-range"></i> Financial Year
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                The financial year end date determines the period shown on the accounts dashboard. The default is 31st July to match the typical Girlguiding year.
                            </p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Year End Day</label>
                                    <InputNumber class="form-control" @bind-Value="_config.FinancialYearEndDay" />
                                    <ValidationMessage For="@(() => _config.FinancialYearEndDay)" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Year End Month</label>
                                    <InputSelect class="form-select" @bind-Value="_config.FinancialYearEndMonth">
                                        <option value="1">January</option>
                                        <option value="2">February</option>
                                        <option value="3">March</option>
                                        <option value="4">April</option>
                                        <option value="5">May</option>
                                        <option value="6">June</option>
                                        <option value="7">July</option>
                                        <option value="8">August</option>
                                        <option value="9">September</option>
                                        <option value="10">October</option>
                                        <option value="11">November</option>
                                        <option value="12">December</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _config.FinancialYearEndMonth)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Emergency Contacts (for Home Contact Sheets) -->
                    <div class="card mb-4">
                        <div class="card-header" style="background-color: var(--gg-dark-navy); color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-telephone"></i> Emergency Contacts
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                These details appear on Home Contact sheets generated for events.
                            </p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">District Commissioner Name</label>
                                    <InputText class="form-control" @bind-Value="_config.DistrictCommissionerName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">District Commissioner Phone</label>
                                    <InputText class="form-control" @bind-Value="_config.DistrictCommissionerPhone" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Division Commissioner Name</label>
                                    <InputText class="form-control" @bind-Value="_config.DivisionCommissionerName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Division Commissioner Phone</label>
                                    <InputText class="form-control" @bind-Value="_config.DivisionCommissionerPhone" />
                                </div>
                            </div>
                            <div class="alert alert-info mt-3 mb-0">
                                <i class="bi bi-exclamation-circle"></i>
                                <strong>Girlguiding Emergency Safety Line: 0207 592 1828</strong><br />
                                <small>In the event of a serious accident or death, Girlguiding must be contacted within 1 hour via this line. This number is automatically included on all Home Contact sheets.</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-check-lg"></i> Save Settings
                        </button>
                    </div>
                </EditForm>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-info-circle text-primary"></i> About These Settings
                        </h6>
                        <ul class="mb-0 ps-3">
                            <li class="mb-2"><strong>Unit Type</strong> determines the section for all girls in this unit</li>
                            <li class="mb-2"><strong>Meeting Day</strong> is used when auto-generating meetings for a term</li>
                            <li class="mb-2"><strong>Default times</strong> are pre-filled when creating new meetings</li>
                            <li class="mb-2"><strong>Default location</strong> is pre-filled for new meetings</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="toast-fixed alert alert-success alert-dismissible mb-0 shadow" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @_successMessage
        <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
    </div>
}