@page "/Inventory/Stock/{Id:int}"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Stock Detail - GUMS</PageTitle>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Inventory">Inventory</a></li>
            <li class="breadcrumb-item active">@(_item?.Name ?? "Stock Item")</li>
        </ol>
    </nav>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_item == null)
    {
        <div class="alert alert-warning">Stock item not found.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h2>@_item.Name</h2>
                <div class="text-muted">
                    <span class="badge bg-secondary me-2">@StockTypeLabel(_item.StockType)</span>
                    @if (_item.ThemeAwardLevel.HasValue)
                    {
                        <span class="badge bg-warning text-dark me-2">@_item.ThemeAwardLevel</span>
                    }
                    @if (_item.NightsAwayTier.HasValue)
                    {
                        <span class="badge bg-info text-dark me-2">@_item.NightsAwayTier nights</span>
                    }
                    @if (!_item.IsActive)
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/Inventory/Stock/Adjust/@Id" class="btn btn-primary">
                    <i class="bi bi-plus-minus"></i> Record Transaction
                </a>
                <a href="/Inventory/Stock/Edit/@Id" class="btn btn-outline-secondary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>
        </div>

        <!-- Summary cards -->
        <div class="row mb-4 g-3">
            <div class="col-md-3">
                <div class="card text-center h-100" style="border-color: @StockColour; border-width: 2px;">
                    <div class="card-body">
                        <h6 class="text-muted">In Stock</h6>
                        <h1 style="color: @StockColour;">@_item.CurrentQuantity</h1>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Reorder At</h6>
                        <h2>@(_item.ReorderThreshold?.ToString() ?? "—")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Unit Cost</h6>
                        <h2>@(_item.UnitCost.HasValue ? $"£{_item.UnitCost:N2}" : "—")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h6 class="text-muted">Total Value</h6>
                        <h2>@(_item.UnitCost.HasValue ? $"£{_item.UnitCost * _item.CurrentQuantity:N2}" : "—")</h2>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_item.Notes))
        {
            <div class="alert alert-light border mb-4">
                <i class="bi bi-sticky"></i> @_item.Notes
            </div>
        }

        <!-- Transaction history -->
        <div class="card">
            <div class="card-header" style="background-color: var(--gg-primary-blue); color: white;">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Transaction History</h5>
            </div>
            <div class="card-body p-0">
                @if (!_transactions.Any())
                {
                    <p class="text-muted text-center py-4">No transactions yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-center">Running Total</th>
                                    <th class="text-end">Cost</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var running = _item.CurrentQuantity;
                                }
                                @foreach (var txn in _transactions)
                                {
                                    <tr>
                                        <td>@txn.TransactionDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <span class="badge @TxnBadgeClass(txn.TransactionType)">
                                                @TxnLabel(txn.TransactionType)
                                            </span>
                                        </td>
                                        <td class="text-center @(txn.Quantity > 0 ? "text-success" : "text-danger")">
                                            @(txn.Quantity > 0 ? $"+{txn.Quantity}" : txn.Quantity.ToString())
                                        </td>
                                        <td class="text-center">@running</td>
                                        <td class="text-end">@(txn.TotalCost.HasValue ? $"£{txn.TotalCost:N2}" : "—")</td>
                                        <td class="text-muted small">
                                            @(txn.Notes ?? "—")
                                            @if (txn.ExpenseClaimId.HasValue)
                                            {
                                                <a href="/Accounts/Claims/@txn.ExpenseClaimId" class="ms-1 badge bg-info text-dark text-decoration-none">
                                                    <i class="bi bi-file-earmark-text"></i> Claim #@txn.ExpenseClaimId
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                    running -= txn.Quantity;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>
