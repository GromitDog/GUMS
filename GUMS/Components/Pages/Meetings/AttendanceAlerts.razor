@page "/Meetings/Alerts"
@rendermode InteractiveServer

<PageTitle>Attendance Alerts - GUMS</PageTitle>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Meetings">Meetings</a></li>
            <li class="breadcrumb-item active">Attendance Alerts</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Attendance Alerts</h2>
            <p class="text-muted mb-0">
                Members who have missed 5 or more consecutive regular meetings.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Checking attendance records...</p>
        </div>
    }
    else if (!_alerts.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i> Great news! No attendance concerns. All members have attended within the last 5 regular meetings.
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header bg-warning">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i> Attendance Concerns (@_alerts.Count)
                </h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    These members have missed 5 or more consecutive regular meetings. Camps and special events are not counted. Consider reaching out to check in with their families.
                </p>

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Member</th>
                                <th class="d-none d-md-table-cell">Membership #</th>
                                <th>Consecutive Missed</th>
                                <th class="d-none d-md-table-cell">Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in _alerts)
                            {
                                <tr>
                                    <td>
                                        <strong>@alert.MemberName</strong>
                                    </td>
                                    <td class="d-none d-md-table-cell">@alert.MembershipNumber</td>
                                    <td>
                                        <span class="badge @(alert.TotalMeetings >= 10 ? "bg-danger" : "bg-warning text-dark")">
                                            @alert.TotalMeetings @(alert.TotalMeetings == 1 ? "meeting" : "meetings")
                                        </span>
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        @if (!string.IsNullOrEmpty(GetAlertNote(alert.MembershipNumber)))
                                        {
                                            <small class="text-muted">@GetAlertNote(alert.MembershipNumber)</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted fst-italic">No notes</small>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenNoteModal(alert)">
                                            <i class="bi bi-pencil"></i> <span class="d-none d-md-inline">Add Note</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tips Card -->
        <div class="card">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="bi bi-lightbulb text-warning"></i> Tips for Following Up
                </h6>
                <ul class="mb-0 ps-3">
                    <li class="mb-2">Reach out to parents via email or phone to check if everything is okay</li>
                    <li class="mb-2">Add notes about conversations to keep track of reasons (illness, holidays, etc.)</li>
                    <li class="mb-2">Always approach with care and understanding — there may be family circumstances</li>
                    <li class="mb-2">Only regular weekly meetings count — camps and special events are excluded</li>
                </ul>
            </div>
        </div>
    }
</div>

<!-- Note Modal -->
@if (showNoteModal && selectedAlert != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Note for @selectedAlert.MemberName</h5>
                    <button type="button" class="btn-close" @onclick="CloseNoteModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Note</label>
                        <textarea class="form-control" rows="3" @bind="noteText"
                                  placeholder="e.g., Spoke to parent on 15 Jan - family illness, expecting return next week"></textarea>
                        <small class="text-muted">Record any conversations or reasons for absence</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseNoteModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveNote">
                        <i class="bi bi-check"></i> Save Note
                    </button>
                </div>
            </div>
        </div>
    </div>
}
