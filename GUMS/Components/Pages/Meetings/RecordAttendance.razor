@page "/Meetings/Attendance/{MeetingId:int}"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Record Attendance - GUMS</PageTitle>

<div class="container-fluid py-4 mobile-sticky-page">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Meetings">Meetings</a></li>
            <li class="breadcrumb-item"><a href="/Meetings/View/@MeetingId">Meeting Details</a></li>
            <li class="breadcrumb-item active">Record Attendance</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (meeting == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i> Meeting not found.
        </div>
    }
    else
    {
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 mb-md-4 gap-2">
            <div>
                <h2 class="d-none d-md-block">Record Attendance</h2>
                <p class="text-muted mb-0 d-none d-md-block">
                    <strong>@meeting.Title</strong> - @meeting.Date.ToString("dddd, dd MMMM yyyy")
                </p>
                <!-- Phones: the meeting is the heading, leaving more of the screen for the list -->
                <h2 class="h4 mb-0 d-md-none">@meeting.Title</h2>
                <p class="text-muted mb-0 d-md-none">@meeting.Date.ToString("dddd d MMMM")</p>
            </div>
            <div class="d-none d-md-block">
                <button class="btn btn-success btn-lg" @onclick="SaveAttendance" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    <i class="bi bi-check-lg"></i> Save Attendance
                </button>
            </div>
        </div>

        @if (HasSectionChoice)
        {
            <!-- Phones: one section at a time, opening on the job for this meeting's date -->
            <div class="btn-group w-100 mb-3 d-md-none" role="group" aria-label="Register sections">
                <input type="radio" class="btn-check" name="registerSection" id="sectionRegister" autocomplete="off"
                       checked="@(_activeSection == RegisterSection.Register)"
                       @onchange="@(() => ShowSection(RegisterSection.Register))" />
                <label class="btn btn-outline-primary" for="sectionRegister">
                    <i class="bi bi-clipboard-check"></i> Register
                </label>
                @if (requiresConsent)
                {
                    <input type="radio" class="btn-check" name="registerSection" id="sectionConsent" autocomplete="off"
                           checked="@(_activeSection == RegisterSection.Consent)"
                           @onchange="@(() => ShowSection(RegisterSection.Consent))" />
                    <label class="btn btn-outline-primary" for="sectionConsent">
                        <i class="bi bi-file-earmark-check"></i> Consent
                    </label>
                }
                @if (OffersAvailabilitySection)
                {
                    <input type="radio" class="btn-check" name="registerSection" id="sectionAvailability" autocomplete="off"
                           checked="@(_activeSection == RegisterSection.Availability)"
                           @onchange="@(() => ShowSection(RegisterSection.Availability))" />
                    <label class="btn btn-outline-primary" for="sectionAvailability">
                        <i class="bi bi-person-badge"></i> Leaders
                    </label>
                }
            </div>
        }

        <div class="row">
            <div class="col-lg-8">
                <!-- Quick Stats (not while planning leaders on a phone, where present/absent means nothing yet) -->
                <div class="card mb-3 @(_activeSection == RegisterSection.Availability ? "d-none d-md-flex" : "")">
                    <div class="card-body py-2">
                        @{
                            var visibleRecords = GetVisibleAttendanceRecords();
                            var girlAttendanceRecords = attendanceRecords.Where(a => memberLookup.ContainsKey(a.MembershipNumber) && memberLookup[a.MembershipNumber].PersonType == Data.Enums.PersonType.Girl).ToList();
                        }
                        @if (_activeSection == RegisterSection.Consent)
                        {
                            var saidYes = girlAttendanceRecords.Count(a => a.ConsentFormReceived || a.ConsentEmailReceived);
                            var saidNo = girlAttendanceRecords.Count(a => a.ConsentDeclined);
                            var noAnswer = girlAttendanceRecords.Count(a => !a.ConsentEmailReceived && !a.ConsentFormReceived && !a.ConsentDeclined);
                            var chaseForForms = girlAttendanceRecords.Count(a => a.ConsentEmailReceived && !a.ConsentFormReceived && !a.ConsentDeclined);
                            <div class="d-flex justify-content-around text-center gap-2">
                                <div>
                                    <h4 class="mb-0 text-success">@saidYes</h4>
                                    <small class="text-muted d-block lh-sm">Said Yes</small>
                                </div>
                                <div>
                                    <h4 class="mb-0 text-danger">@saidNo</h4>
                                    <small class="text-muted d-block lh-sm">Declined</small>
                                </div>
                                <div>
                                    <h4 class="mb-0 @(noAnswer > 0 ? "text-secondary" : "")">@noAnswer</h4>
                                    <small class="text-muted d-block lh-sm">No Answer</small>
                                </div>
                                <div>
                                    <h4 class="mb-0 @(chaseForForms > 0 ? "text-warning" : "text-success")">@chaseForForms</h4>
                                    <small class="text-muted d-block lh-sm">Chase Forms</small>
                                </div>
                                <div>
                                    <h4 class="mb-0">@girlAttendanceRecords.Count</h4>
                                    <small class="text-muted d-block lh-sm">Total</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-around text-center">
                                <div>
                                    <h4 class="mb-0 text-success">@visibleRecords.Count(a => a.Attended)</h4>
                                    <small class="text-muted">Present</small>
                                </div>
                                <div>
                                    <h4 class="mb-0 text-danger">@visibleRecords.Count(a => !a.Attended)</h4>
                                    <small class="text-muted">Absent</small>
                                </div>
                                <div>
                                    <h4 class="mb-0 text-primary">@visibleRecords.Count</h4>
                                    <small class="text-muted">Total</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Consent Tracking (if meeting requires consent) - above attendance on desktop, its own tab on phones -->
                @if (requiresConsent)
                {
                    <div class="card mb-3 @PhoneSectionClass(RegisterSection.Consent)">
                        <div class="card-header" style="background-color: #FFC107; color: #212529;">
                            <h5 class="mb-0">
                                <i class="bi bi-file-earmark-check"></i> Consent Form Tracking
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3 d-none d-md-block">
                                This meeting has activities that require consent forms. Track the status of consent below.
                                Only members with a received consent form will appear in the attendance checklist.
                            </p>

                            <!-- Desktop: table view -->
                            <div class="table-responsive d-none d-md-block">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>Member</th>
                                            <th class="text-center">Email</th>
                                            <th class="text-center">Form In</th>
                                            <th class="text-center">Declined</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in attendanceRecords.Where(a => memberLookup.ContainsKey(a.MembershipNumber) && memberLookup[a.MembershipNumber].PersonType == PersonType.Girl).OrderBy(a => memberLookup[a.MembershipNumber].FullName))
                                        {
                                            var member = memberLookup[record.MembershipNumber];
                                            <tr>
                                                <td>@member.FullName</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@record.ConsentEmailReceived"
                                                           @onchange="@(e => ToggleConsentEmail(record, (bool)(e.Value ?? false)))" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@record.ConsentFormReceived"
                                                           @onchange="@(e => ToggleConsentForm(record, (bool)(e.Value ?? false)))" />
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@record.ConsentDeclined"
                                                           @onchange="@(e => ToggleConsentDeclined(record, (bool)(e.Value ?? false)))" />
                                                </td>
                                                <td>
                                                    @if (record.ConsentFormReceived)
                                                    {
                                                        <span class="badge bg-success">Consented</span>
                                                    }
                                                    else if (record.ConsentDeclined)
                                                    {
                                                        <span class="badge bg-secondary">Declined</span>
                                                    }
                                                    else if (record.ConsentEmailReceived)
                                                    {
                                                        <span class="badge bg-warning text-dark">Form Outstanding</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-dark border">Not Started</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Mobile: card view with big toggles, Form in first as it's the usual job -->
                            <div class="d-md-none">
                                @foreach (var record in attendanceRecords.Where(a => memberLookup.ContainsKey(a.MembershipNumber) && memberLookup[a.MembershipNumber].PersonType == PersonType.Girl).OrderBy(a => memberLookup[a.MembershipNumber].FullName))
                                {
                                    var member = memberLookup[record.MembershipNumber];
                                    <div class="mobile-consent-card">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <strong>@member.FullName</strong>
                                            @if (record.ConsentFormReceived)
                                            {
                                                <span class="badge bg-success">Consented</span>
                                            }
                                            else if (record.ConsentDeclined)
                                            {
                                                <span class="badge bg-secondary">Declined</span>
                                            }
                                            else if (record.ConsentEmailReceived)
                                            {
                                                <span class="badge bg-warning text-dark">Form Outstanding</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">Not Started</span>
                                            }
                                        </div>
                                        <div class="d-flex gap-2">
                                            <input type="checkbox" class="btn-check" id="consent-form-@record.MembershipNumber" autocomplete="off"
                                                   checked="@record.ConsentFormReceived"
                                                   @onchange="@(e => ToggleConsentForm(record, (bool)(e.Value ?? false)))" />
                                            <label class="btn btn-outline-success flex-grow-1" for="consent-form-@record.MembershipNumber">
                                                <i class="bi bi-file-earmark-check"></i> Form in
                                            </label>
                                            <input type="checkbox" class="btn-check" id="consent-email-@record.MembershipNumber" autocomplete="off"
                                                   checked="@record.ConsentEmailReceived"
                                                   @onchange="@(e => ToggleConsentEmail(record, (bool)(e.Value ?? false)))" />
                                            <label class="btn btn-outline-primary" for="consent-email-@record.MembershipNumber">Email</label>
                                            <input type="checkbox" class="btn-check" id="consent-declined-@record.MembershipNumber" autocomplete="off"
                                                   checked="@record.ConsentDeclined"
                                                   @onchange="@(e => ToggleConsentDeclined(record, (bool)(e.Value ?? false)))" />
                                            <label class="btn btn-outline-secondary" for="consent-declined-@record.MembershipNumber">Declined</label>
                                        </div>
                                    </div>
                                }
                            </div>

                            @{
                                var allGirlRecords = attendanceRecords.Where(a => memberLookup.ContainsKey(a.MembershipNumber) && memberLookup[a.MembershipNumber].PersonType == PersonType.Girl).ToList();
                                var consentFormsIn = allGirlRecords.Count(r => r.ConsentFormReceived);
                                var consentDeclinedCount = allGirlRecords.Count(r => r.ConsentDeclined);
                                var consentResponded = consentFormsIn + consentDeclinedCount;
                                var consentToChase = allGirlRecords.Count - consentResponded;
                            }
                            <div class="d-flex justify-content-between align-items-center mt-3 p-2 bg-light rounded">
                                <div>
                                    <strong>@consentResponded / @allGirlRecords.Count responded</strong>
                                    <span class="text-muted ms-2">(@consentFormsIn consented, @consentDeclinedCount declined)</span>
                                </div>
                                @if (consentToChase > 0)
                                {
                                    <span class="text-warning fw-semibold">
                                        <i class="bi bi-exclamation-triangle"></i> @consentToChase still to chase
                                    </span>
                                }
                                else
                                {
                                    <span class="text-success fw-semibold">
                                        <i class="bi bi-check-circle"></i> Everyone has responded
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Leader Availability -->
                @{
                    var leaderRecords = attendanceRecords.Where(a => memberLookup.ContainsKey(a.MembershipNumber) && memberLookup[a.MembershipNumber].PersonType == PersonType.Leader)
                        .OrderBy(a => memberLookup[a.MembershipNumber].FullName)
                        .ToList();
                }
                @if (leaderRecords.Any())
                {
                    <div class="card mb-3 @PhoneSectionClass(RegisterSection.Availability)">
                        <div class="card-header" style="background-color: #FFF3CD; color: #212529;">
                            <h5 class="mb-0">
                                <i class="bi bi-person-badge"></i> Leader Availability
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                Mark which leaders are planning to attend. This is used for budget planning and ratio calculations.
                            </p>

                            <!-- Desktop: table view -->
                            <div class="table-responsive d-none d-md-block">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>Leader</th>
                                            <th class="text-center">Planning to Attend</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in leaderRecords)
                                        {
                                            var member = memberLookup[record.MembershipNumber];
                                            <tr>
                                                <td>@member.FullName</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@record.PlanningToAttend"
                                                           @onchange="@(e => TogglePlanningToAttend(record, (bool)(e.Value ?? false)))" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Mobile: card view -->
                            <div class="d-md-none">
                                @foreach (var record in leaderRecords)
                                {
                                    var member = memberLookup[record.MembershipNumber];
                                    <label class="mobile-consent-card d-flex justify-content-between align-items-center">
                                        <strong>@member.FullName</strong>
                                        <span class="form-check mb-0">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@record.PlanningToAttend"
                                                   @onchange="@(e => TogglePlanningToAttend(record, (bool)(e.Value ?? false)))" />
                                            <span class="form-check-label small">Planning to attend</span>
                                        </span>
                                    </label>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 p-2 bg-light rounded">
                                <div>
                                    <strong>@leaderRecords.Count(r => r.PlanningToAttend) / @leaderRecords.Count planning to attend</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Attendance Checklist -->
                <div class="card @PhoneSectionClass(RegisterSection.Register)">
                    <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--gg-primary-blue); color: white;">
                        <h5 class="mb-0 d-none d-md-block">
                            <i class="bi bi-people"></i> Attendance Checklist
                        </h5>
                        <div class="d-flex gap-2 flex-fill flex-md-grow-0">
                            <button class="btn btn-sm btn-light flex-fill flex-md-grow-0" @onclick="MarkAllPresent">
                                <i class="bi bi-check-all"></i> All Present
                            </button>
                            <button class="btn btn-sm btn-outline-light flex-fill flex-md-grow-0" @onclick="MarkAllAbsent">
                                <i class="bi bi-x"></i> Clear All
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @{
                            var girls = attendanceRecords.Where(a => memberLookup.ContainsKey(a.MembershipNumber) && memberLookup[a.MembershipNumber].PersonType == PersonType.Girl
                                && (!requiresConsent || a.ConsentFormReceived))
                                .OrderBy(a => memberLookup[a.MembershipNumber].FullName)
                                .ToList();
                            var leaders = attendanceRecords.Where(a => memberLookup.ContainsKey(a.MembershipNumber) && memberLookup[a.MembershipNumber].PersonType == PersonType.Leader)
                                .OrderBy(a => memberLookup[a.MembershipNumber].FullName)
                                .ToList();
                        }

                        @if (requiresConsent)
                        {
                            <div class="px-3 py-2 small text-muted border-bottom">
                                <i class="bi bi-info-circle"></i> Only girls with a consent form in are listed.
                                <button type="button" class="btn btn-link btn-sm p-0 align-baseline d-md-none"
                                        @onclick="@(() => ShowSection(RegisterSection.Consent))">
                                    Record a form
                                </button>
                            </div>
                        }

                        @if (girls.Any())
                        {
                            <div class="px-3 py-2" style="background-color: #E3F2FD;">
                                <strong><i class="bi bi-people-fill"></i> Girls (@girls.Count)</strong>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var record in girls)
                                {
                                    var member = memberLookup[record.MembershipNumber];
                                    <label class="list-group-item register-row d-flex justify-content-between align-items-center mb-0 @(record.Attended ? "list-group-item-success" : "")">
                                        <span class="d-flex align-items-center">
                                            <span class="form-check form-switch me-3">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       id="att-@record.MembershipNumber"
                                                       checked="@record.Attended"
                                                       @onchange="@(e => ToggleAttendance(record, (bool)(e.Value ?? false)))"
                                                       style="width: 3em; height: 1.5em;" />
                                            </span>
                                            <span>
                                                <strong>@member.FullName</strong>
                                                <br />
                                                <small class="text-muted">@member.MembershipNumber @(member.Section != null ? $"- {member.Section}" : "")</small>
                                            </span>
                                        </span>
                                        <span>
                                            @if (record.Attended)
                                            {
                                                <span class="badge bg-success">Present</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Absent</span>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        }

                        @if (leaders.Any())
                        {
                            <div class="px-3 py-2" style="background-color: #FFF3CD;">
                                <strong><i class="bi bi-person-badge"></i> Leaders (@leaders.Count)</strong>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var record in leaders)
                                {
                                    var member = memberLookup[record.MembershipNumber];
                                    <label class="list-group-item register-row d-flex justify-content-between align-items-center mb-0 @(record.Attended ? "list-group-item-success" : "")">
                                        <span class="d-flex align-items-center">
                                            <span class="form-check form-switch me-3">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       id="att-@record.MembershipNumber"
                                                       checked="@record.Attended"
                                                       @onchange="@(e => ToggleAttendance(record, (bool)(e.Value ?? false)))"
                                                       style="width: 3em; height: 1.5em;" />
                                            </span>
                                            <span>
                                                <strong>@member.FullName</strong>
                                                <br />
                                                <small class="text-muted">@member.MembershipNumber - Leader</small>
                                            </span>
                                        </span>
                                        <span>
                                            @if (record.Attended)
                                            {
                                                <span class="badge bg-success">Present</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Absent</span>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        }

                        @if (!girls.Any() && !leaders.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-people" style="font-size: 2rem;"></i>
                                @if (requiresConsent)
                                {
                                    <p class="mb-0">No members with consent forms received yet. Record received forms under Consent Form Tracking.</p>
                                }
                                else
                                {
                                    <p class="mb-0">No active members found. Add members to your register first.</p>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Activity Completions -->
                @if (_meetingActivities.Any(a => a.BadgeClauseId.HasValue || a.UmaDefinitionId.HasValue || a.BadgeDefinitionId.HasValue))
                {
                    <div class="card mt-4 @PhoneSectionClass(RegisterSection.Register)">
                        <div class="card-header" style="background-color: #7B1FA2; color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-check2-square"></i> Record Activity Completions
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                Tick which girls completed each linked activity. By default, all attendees are marked as completed.
                            </p>
                            @foreach (var activity in _meetingActivities.Where(a => a.BadgeClauseId.HasValue || a.UmaDefinitionId.HasValue || a.BadgeDefinitionId.HasValue))
                            {
                                <div class="mb-3">
                                    <h6>
                                        @activity.Name
                                        @if (activity.BadgeClauseId.HasValue)
                                        {
                                            <span class="badge bg-primary ms-1">Badge Clause</span>
                                        }
                                        @if (activity.UmaDefinitionId.HasValue)
                                        {
                                            <span class="badge bg-info ms-1">UMA</span>
                                        }
                                        @if (activity.BadgeDefinitionId.HasValue && !activity.BadgeClauseId.HasValue)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Fun Badge</span>
                                        }
                                    </h6>
                                    <div class="row">
                                        @foreach (var record in attendanceRecords.Where(a => a.Attended && memberLookup.ContainsKey(a.MembershipNumber) && memberLookup[a.MembershipNumber].PersonType == Data.Enums.PersonType.Girl))
                                        {
                                            var member = memberLookup[record.MembershipNumber];
                                            <div class="col-md-4 col-lg-3 mb-1">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox"
                                                           id="done-@activity.Id-@record.MembershipNumber"
                                                           checked="@GetCompletion(activity.Id, record.MembershipNumber)"
                                                           @onchange="@(e => SetCompletion(activity.Id, record.MembershipNumber, (bool)(e.Value ?? false)))" />
                                                    <label class="form-check-label small" for="done-@activity.Id-@record.MembershipNumber">@member.FullName</label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Nights Away Tracking (for multi-day meetings) -->
                @if (isMultiDayMeeting)
                {
                    <div class="card mt-4 @PhoneSectionClass(RegisterSection.Register)">
                        <div class="card-header" style="background-color: #198754; color: white;">
                            <h5 class="mb-0">
                                <i class="bi bi-moon-stars"></i> Nights Away Tracking
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                This is a multi-day event (@defaultNightsAway night@(defaultNightsAway != 1 ? "s" : "")).
                                Nights away are auto-calculated when marking attendance, but you can adjust if someone left early.
                            </p>

                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Member</th>
                                            <th class="text-center" style="width: 120px;">Nights Away</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in attendanceRecords.Where(a => a.Attended && memberLookup.ContainsKey(a.MembershipNumber)).OrderBy(a => memberLookup[a.MembershipNumber].FullName))
                                        {
                                            var member = memberLookup[record.MembershipNumber];
                                            <tr>
                                                <td>
                                                    @member.FullName
                                                    <small class="text-muted d-block">@(member.PersonType == PersonType.Leader ? "Leader" : member.Section?.ToString())</small>
                                                </td>
                                                <td class="text-center">
                                                    <input type="number" class="form-control form-control-sm text-center"
                                                           min="0" max="@defaultNightsAway"
                                                           value="@(record.NightsAway ?? defaultNightsAway)"
                                                           @onchange="@(e => UpdateNightsAway(record, int.TryParse(e.Value?.ToString(), out var n) ? n : null))"
                                                           style="width: 80px; display: inline-block;" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (!attendanceRecords.Any(a => a.Attended))
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle"></i> Mark members as present above to track their nights away.
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center mt-3 p-2 bg-light rounded">
                                    <div>
                                        <strong>Total:</strong>
                                        <span class="ms-2">@attendanceRecords.Where(a => a.Attended).Sum(a => a.NightsAway ?? 0) nights across @attendanceRecords.Count(a => a.Attended) attendees</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <!-- Meeting Info Card -->
                <div class="card mb-3">
                    <div class="card-header" style="background-color: var(--gg-dark-navy); color: white;">
                        <h6 class="mb-0">Meeting Information</h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-2">
                            <strong>Date:</strong><br />
                            @if (isMultiDayMeeting)
                            {
                                @meeting.Date.ToString("ddd, dd MMM")@: - @meeting.EndDate!.Value.ToString("ddd, dd MMM yyyy")
                                <br />
                                <span class="badge bg-info">@defaultNightsAway night@(defaultNightsAway != 1 ? "s" : "") away</span>
                            }
                            else
                            {
                                @meeting.Date.ToString("dddd, dd MMMM yyyy")
                            }
                        </p>
                        <p class="mb-2">
                            <strong>Time:</strong><br />
                            @meeting.StartTime.ToString("HH:mm") - @meeting.EndTime.ToString("HH:mm")
                        </p>
                        <p class="mb-2">
                            <strong>Location:</strong><br />
                            @meeting.LocationName
                        </p>
                        @if (meeting.MeetingType == MeetingType.Extra)
                        {
                            <p class="mb-0">
                                <span class="badge badge-gg-special">Special Event</span>
                            </p>
                        }
                    </div>
                </div>

                <!-- Tips Card (hidden on mobile) -->
                <div class="card d-none d-lg-block">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-lightbulb text-warning"></i> Quick Tips
                        </h6>
                        <ul class="mb-0 ps-3">
                            <li class="mb-2">Click the toggle switch to mark each member as present or absent</li>
                            <li class="mb-2">Use "All Present" if most members attended, then uncheck absences</li>
                            <li class="mb-2">Click "Save Attendance" when you're done</li>
                            @if (requiresConsent)
                            {
                                <li class="mb-2">Track consent forms below - check "Email" when parent confirms, "Form" when paper form received</li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Actions (phones save from the sticky bar instead) -->
                <div class="d-grid gap-2 mt-3">
                    <button class="btn btn-success btn-lg d-none d-md-block" @onclick="SaveAttendance" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        <i class="bi bi-check-lg"></i> Save Attendance
                    </button>
                    <a href="/Meetings/View/@MeetingId" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Meeting
                    </a>
                </div>
            </div>
        </div>

        <!-- Mobile sticky save bar: stays on the register so late arrivals can still be ticked off -->
        <div class="d-md-none mobile-sticky-action">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="small text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
                </div>
            }
            @if (_savedAt.HasValue)
            {
                <button class="btn btn-outline-success btn-lg w-100" @onclick="SaveAndStay" disabled="@isSaving">
                    <i class="bi bi-check-circle-fill"></i> Saved at @_savedAt.Value.ToString("HH:mm")
                </button>
            }
            else
            {
                <button class="btn btn-success btn-lg w-100" @onclick="SaveAndStay" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    <i class="bi bi-check-lg"></i> Save Attendance
                </button>
            }
        </div>
    }
</div>
