@page "/Meetings/Timetable"
@page "/Meetings/Timetable/{TermId:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Programme - GUMS</PageTitle>

<style>
    .timetable-wrapper {
        max-width: 800px;
        margin: 0 auto;
        font-family: Arial, sans-serif;
    }

    .timetable-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .timetable-heading h1 {
        font-size: 1.8rem;
        font-weight: bold;
        text-decoration: underline;
        margin: 0 0 0.25rem 0;
        text-align: center;
    }

    .timetable-heading h2 {
        font-size: 1.5rem;
        font-weight: bold;
        text-decoration: underline;
        margin: 0 0 1rem 0;
        text-align: center;
    }

    .timetable-logo img {
        max-height: 90px;
        border: 3px solid #1a2b6b;
        padding: 6px;
        background: #1a2b6b;
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
    }

    .timetable-intro {
        margin-bottom: 1.25rem;
        font-size: 0.95rem;
    }

    .timetable-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

    .timetable-table th {
        border: 1px solid #333;
        padding: 8px 12px;
        font-size: 1.05rem;
        font-weight: bold;
        text-align: center;
    }

    .timetable-table td {
        border: 1px solid #888;
        padding: 6px 12px;
        vertical-align: top;
    }

    .timetable-table .row-grey {
        background-color: #d3d3d3;
        text-align: center;
    }

    .timetable-table .row-grey td {
        text-align: center;
    }

    .timetable-table .row-nonstandard td {
        font-weight: bold;
    }

    @@media print {
        .no-print {
            display: none !important;
        }
        body {
            font-size: 10pt;
        }
        .container-fluid, .container {
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
        }
        .timetable-wrapper {
            max-width: 100%;
        }
    }
</style>

<div class="container-fluid py-3">

    <!-- Controls (hidden on print) -->
    <div class="no-print mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <a href="/Meetings" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Meetings
            </a>
            @if (_allTerms.Any())
            {
                <div class="d-flex align-items-center gap-2">
                    <label class="mb-0 fw-semibold">Term:</label>
                    <select class="form-select form-select-sm" style="width: auto;"
                            value="@(_term?.Id ?? 0)"
                            @onchange="OnTermChanged">
                        @foreach (var t in _allTerms.OrderByDescending(t => t.StartDate))
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
            }
            <a href="/Meetings/LeadersTimetable@(_term != null ? "/" + _term.Id : "")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-clipboard-check"></i> Switch to leaders' version
            </a>
        </div>
        <button class="btn btn-primary btn-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> Print / Save as PDF
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_term == null)
    {
        <div class="alert alert-info no-print">
            <i class="bi bi-info-circle"></i> No term found. Please create a term first.
        </div>
    }
    else if (_config == null)
    {
        <div class="alert alert-warning no-print">
            <i class="bi bi-exclamation-triangle"></i> Unit configuration not found.
        </div>
    }
    else
    {
        <div class="timetable-wrapper">

            <!-- Header -->
            <div class="timetable-header">
                <div class="timetable-heading">
                    <h1>Timetable</h1>
                    <h2>@_term.Name</h2>
                    <p class="timetable-intro">
                        Unless otherwise stated, all meetings are held at @_config.DefaultLocationName,
                        @FormatTime(_config.DefaultMeetingStartTime)-@FormatTime(_config.DefaultMeetingEndTime)
                        and all those who have made their promise are expected to wear full uniform.
                    </p>
                </div>
                <div class="timetable-logo">
                    <img src="/unitLogoWhite.png" alt="Unit logo" />
                </div>
            </div>

            <!-- Timetable -->
            <table class="timetable-table">
                <thead>
                    <tr>
                        <th style="width: 18%;">Date</th>
                        <th style="width: 37%;">Activity</th>
                        <th style="width: 45%;">Other details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var isGrey = row.IsMissingWeek || row.IsPostTerm;
                        <tr class="@(isGrey ? "row-grey" : row.IsNonStandardDay ? "row-nonstandard" : "")">
                            <td>
                                @if (row.IsNonStandardDay)
                                {
                                    <strong>
                                        @if (row.EndDate.HasValue)
                                        {
                                            @FormatDateRange(row.Date, row.EndDate.Value)
                                        }
                                        else
                                        {
                                            @($"{row.Date.ToString("ddd")} {FormatDate(row.Date)}")
                                        }
                                    </strong>
                                }
                                else
                                {
                                    @FormatDate(row.Date)
                                }
                            </td>
                            <td>
                                @if (isGrey)
                                {
                                    <strong>@row.Title</strong>
                                }
                                else
                                {
                                    @row.Title
                                }
                            </td>
                            <td>
                                @if (isGrey && !string.IsNullOrEmpty(row.OtherDetails))
                                {
                                    <strong>@row.OtherDetails</strong>
                                }
                                else if (row.IsNextTerm)
                                {
                                    <em>@row.OtherDetails</em>
                                }
                                else
                                {
                                    @row.OtherDetails
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }
</div>
