@page "/Payments/MemberHistory/{MembershipNumber}"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Payment History - GUMS</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Payment History</h2>
        <a href="/Payments" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Payments
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading payment history...</p>
        </div>
    }
    else
    {
        <!-- Member Summary Card -->
        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header" style="background-color: var(--gg-primary-blue); color: white;">
                        <h5 class="mb-0">
                            <i class="bi bi-person"></i> @_summary.MemberName
                            <small class="ms-2">(@MembershipNumber)</small>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center g-2">
                            <div class="col-4 col-md">
                                <h4 class="mb-0 fs-6 fs-md-4">@_summary.TotalPayments</h4>
                                <small class="text-muted">Payments</small>
                            </div>
                            <div class="col-4 col-md">
                                <h4 class="mb-0 text-success fs-6 fs-md-4">@_summary.TotalPaid.ToString("C")</h4>
                                <small class="text-muted">Paid</small>
                            </div>
                            <div class="col-4 col-md">
                                <h4 class="mb-0 fs-6 fs-md-4 @(_summary.TotalOutstanding > 0 ? "text-danger" : "text-success")">
                                    @_summary.TotalOutstanding.ToString("C")
                                </h4>
                                <small class="text-muted">Outstanding</small>
                            </div>
                            <div class="col-6 col-md d-none d-sm-block">
                                @if (_summary.OverduePayments > 0)
                                {
                                    <h4 class="mb-0 text-danger fs-6 fs-md-4">@_summary.OverduePayments</h4>
                                    <small class="text-danger">Overdue</small>
                                }
                                else
                                {
                                    <h4 class="mb-0 text-success fs-6 fs-md-4"><i class="bi bi-check-circle"></i></h4>
                                    <small class="text-muted">No Overdue</small>
                                }
                            </div>
                            <div class="col-6 col-md d-none d-sm-block">
                                @if (_summary.CreditBalance > 0)
                                {
                                    <h4 class="mb-0 fs-6 fs-md-4" style="color: #ff9800;">@_summary.CreditBalance.ToString("C")</h4>
                                    <small style="color: #ff9800;">Credit</small>
                                }
                                else
                                {
                                    <h4 class="mb-0 text-muted fs-6 fs-md-4">@(0m.ToString("C"))</h4>
                                    <small class="text-muted">Credit</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column justify-content-center">
                        @if (_personId.HasValue)
                        {
                            <a href="/Register/View/@_personId" class="btn btn-outline-primary mb-2">
                                <i class="bi bi-person-lines-fill"></i> View Member Profile
                            </a>
                        }
                        @if (_summary.PendingPayments > 0)
                        {
                            <a href="/Payments?search=@MembershipNumber&status=Pending" class="btn btn-warning mb-2">
                                <i class="bi bi-cash"></i> View Pending Payments
                            </a>
                        }
                        @if (_summary.CreditBalance > 0)
                        {
                            <button class="btn btn-outline-warning mb-2" @onclick="ShowRefundCreditModal">
                                <i class="bi bi-wallet2"></i> Refund Credit (@_summary.CreditBalance.ToString("C"))
                            </button>
                        }
                        <a href="/Payments/Statement/@MembershipNumber" class="btn btn-outline-secondary">
                            <i class="bi bi-printer"></i> Print Statement
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter -->
        <div class="mb-3">
            <div class="btn-group flex-wrap" role="group">
                <button type="button" class="btn @(_paymentTypeFilter == null ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => FilterByType(null)">
                    All (@_payments.Count)
                </button>
                <button type="button" class="btn @(_paymentTypeFilter == PaymentType.Subs ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => FilterByType(PaymentType.Subs)">
                    Subs (@_payments.Count(p => p.PaymentType == PaymentType.Subs))
                </button>
                <button type="button" class="btn @(_paymentTypeFilter == PaymentType.Activity ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => FilterByType(PaymentType.Activity)">
                    Activity (@_payments.Count(p => p.PaymentType == PaymentType.Activity))
                </button>
            </div>
        </div>

        @if (!_filteredPayments.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No payments found for this member.
            </div>
        }
        else
        {
            <!-- Payment History Table -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="d-none d-md-table-cell">Type</th>
                                    <th class="d-none d-lg-table-cell">Reference</th>
                                    <th class="d-none d-md-table-cell text-end">Amount</th>
                                    <th class="d-none d-lg-table-cell text-end">Paid</th>
                                    <th class="text-end">Outstanding</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in _filteredPayments)
                                {
                                    var isOverdue = payment.Status == PaymentStatus.Pending && payment.DueDate < DateTime.Today;

                                    <tr class="@(isOverdue ? "table-warning" : "")">
                                        <td>
                                            @payment.DueDate.ToString("dd MMM yyyy")
                                            @if (payment.PaymentDate.HasValue)
                                            {
                                                <br />
                                                <small class="text-muted">Paid: @payment.PaymentDate.Value.ToString("dd MMM yyyy")</small>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            @if (payment.PaymentType == PaymentType.Subs)
                                            {
                                                <span class="badge badge-gg-subs">Subs</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-gg-activity">Activity</span>
                                            }
                                        </td>
                                        <td class="d-none d-lg-table-cell">
                                            @payment.Reference
                                            @if (payment.CreditApplied > 0)
                                            {
                                                <br />
                                                <small style="color: #ff9800;"><i class="bi bi-wallet2"></i> @payment.CreditApplied.ToString("C") from credit</small>
                                            }
                                            @if (!string.IsNullOrEmpty(payment.Notes))
                                            {
                                                <br />
                                                <small class="text-muted">@payment.Notes</small>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell text-end">@payment.Amount.ToString("C")</td>
                                        <td class="d-none d-lg-table-cell text-end text-success">@payment.AmountPaid.ToString("C")</td>
                                        <td class="text-end">
                                            @if (payment.OutstandingBalance > 0)
                                            {
                                                <strong class="text-danger">@payment.OutstandingBalance.ToString("C")</strong>
                                            }
                                            else
                                            {
                                                <span>@payment.OutstandingBalance.ToString("C")</span>
                                            }
                                        </td>
                                        <td>
                                            @if (isOverdue)
                                            {
                                                <span class="badge badge-gg-overdue">Overdue</span>
                                            }
                                            else if (payment.Status == PaymentStatus.Pending)
                                            {
                                                <span class="badge badge-gg-pending">Pending</span>
                                            }
                                            else if (payment.Status == PaymentStatus.Paid)
                                            {
                                                <span class="badge badge-gg-paid">Paid</span>
                                            }
                                            else if (payment.Status == PaymentStatus.Refunded)
                                            {
                                                <span class="badge badge-gg-refunded">Refunded</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-gg-cancelled">Cancelled</span>
                                            }
                                        </td>
                                        <td>
                                            @if (payment.Status == PaymentStatus.Pending)
                                            {
                                                <a href="/Payments/RecordPayment/@payment.Id" class="btn btn-sm btn-success me-1" title="Record payment">
                                                    <i class="bi bi-cash"></i> <span class="d-none d-md-inline">Pay</span>
                                                </a>
                                                @if (_summary.CreditBalance > 0)
                                                {
                                                    <button class="btn btn-sm btn-outline-warning" @onclick="() => ShowApplyCreditModal(payment)"
                                                            title="Apply credit to this payment">
                                                        <i class="bi bi-wallet2"></i> <span class="d-none d-md-inline">Use Credit</span>
                                                    </button>
                                                }
                                            }
                                            else if (payment.Status == PaymentStatus.Paid)
                                            {
                                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => ShowRefundConfirm(payment)"
                                                        title="Refund as cash">
                                                    <i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-md-inline">Refund</span>
                                                </button>
                                                <button class="btn btn-sm btn-outline-warning" @onclick="() => ShowConvertToCreditModal(payment)"
                                                        title="Convert to credit balance">
                                                    <i class="bi bi-wallet2"></i> <span class="d-none d-md-inline">To Credit</span>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Credit History -->
        @if (_creditHistory.Any())
        {
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-wallet2"></i> Credit History</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th class="text-end">Amount</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in _creditHistory)
                                {
                                    <tr>
                                        <td>@ct.Date.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (ct.Type == CreditTransactionType.Deposit)
                                            {
                                                <span class="badge" style="background-color: #ff9800; color: white;">Credit Added</span>
                                            }
                                            else if (ct.Type == CreditTransactionType.Applied)
                                            {
                                                <span class="badge bg-success">Applied to Payment</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-white">Refunded</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (ct.Amount > 0)
                                            {
                                                <span style="color: #ff9800;">+@ct.Amount.ToString("C")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@ct.Amount.ToString("C")</span>
                                            }
                                        </td>
                                        <td>
                                            @ct.Notes
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Refund Confirmation Modal -->
    @if (_showRefundConfirm && _paymentToRefund != null)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header modal-header-refund">
                        <h5 class="modal-title">
                            <i class="bi bi-arrow-counterclockwise"></i> Refund Payment
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelRefundConfirm"></button>
                    </div>
                    <div class="modal-body">
                        <p>Refund payment for <strong>@_paymentToRefund.Reference</strong> (paid @_paymentToRefund.AmountPaid.ToString("C")).</p>
                        <div class="mb-3">
                            <label class="form-label">Refund Amount <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="_refundAmount" min="0.01"
                                   max="@_paymentToRefund.AmountPaid" step="0.01" />
                            <div class="form-text">Maximum: @_paymentToRefund.AmountPaid.ToString("C")</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Refund Method <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="_refundMethod">
                                <option value="@PaymentMethod.Cash">Cash</option>
                                <option value="@PaymentMethod.Cheque">Cheque</option>
                                <option value="@PaymentMethod.BankTransfer">Bank Transfer</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Refund Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="_refundDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason for refund <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="_refundReason"
                                      placeholder="e.g., Event cancelled, Overpayment..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelRefundConfirm">Close</button>
                        <button type="button" class="btn btn-info text-white" @onclick="RefundPayment"
                                disabled="@(_isRefunding || string.IsNullOrWhiteSpace(_refundReason) || _refundAmount <= 0 || _refundAmount > _paymentToRefund.AmountPaid)">
                            @if (_isRefunding)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-arrow-counterclockwise"></i> Refund Payment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Convert to Credit Modal -->
    @if (_showConvertToCreditModal && _paymentToConvert != null)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header" style="background-color: #ff9800; color: white;">
                        <h5 class="modal-title">
                            <i class="bi bi-wallet2"></i> Convert to Credit
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelConvertToCredit"></button>
                    </div>
                    <div class="modal-body">
                        <p>Convert <strong>@_paymentToConvert.Reference</strong> (paid @_paymentToConvert.AmountPaid.ToString("C")) to credit balance.</p>
                        <p class="text-muted small">The amount will be added to this member's credit balance and can be applied to future payments or refunded later.</p>
                        <div class="mb-3">
                            <label class="form-label">Amount to Convert <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="_convertAmount" min="0.01"
                                   max="@_paymentToConvert.AmountPaid" step="0.01" />
                            <div class="form-text">Maximum: @_paymentToConvert.AmountPaid.ToString("C")</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="_convertReason"
                                      placeholder="e.g., Event cancelled, parent requested credit..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelConvertToCredit">Close</button>
                        <button type="button" class="btn text-white" style="background-color: #ff9800;" @onclick="ConvertToCredit"
                                disabled="@(_isConverting || string.IsNullOrWhiteSpace(_convertReason) || _convertAmount <= 0 || _convertAmount > _paymentToConvert.AmountPaid)">
                            @if (_isConverting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-wallet2"></i> Convert to Credit
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Apply Credit Modal -->
    @if (_showApplyCreditModal && _paymentToApplyCredit != null)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header" style="background-color: #ff9800; color: white;">
                        <h5 class="modal-title">
                            <i class="bi bi-wallet2"></i> Apply Credit
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelApplyCredit"></button>
                    </div>
                    <div class="modal-body">
                        <p>Apply credit to <strong>@_paymentToApplyCredit.Reference</strong> (outstanding @_paymentToApplyCredit.OutstandingBalance.ToString("C")).</p>
                        <p class="text-muted small">Available credit: <strong style="color: #ff9800;">@_summary.CreditBalance.ToString("C")</strong></p>
                        <div class="mb-3">
                            <label class="form-label">Amount to Apply <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="_applyCreditAmount" min="0.01"
                                   max="@Math.Min(_summary.CreditBalance, _paymentToApplyCredit.OutstandingBalance)" step="0.01" />
                            <div class="form-text">Maximum: @Math.Min(_summary.CreditBalance, _paymentToApplyCredit.OutstandingBalance).ToString("C")</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelApplyCredit">Close</button>
                        <button type="button" class="btn text-white" style="background-color: #ff9800;" @onclick="ApplyCredit"
                                disabled="@(_isApplyingCredit || _applyCreditAmount <= 0 || _applyCreditAmount > Math.Min(_summary.CreditBalance, _paymentToApplyCredit.OutstandingBalance))">
                            @if (_isApplyingCredit)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-wallet2"></i> Apply Credit
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Refund Credit Modal -->
    @if (_showRefundCreditModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header modal-header-refund">
                        <h5 class="modal-title">
                            <i class="bi bi-wallet2"></i> Refund Credit Balance
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelRefundCredit"></button>
                    </div>
                    <div class="modal-body">
                        <p>Refund credit balance of <strong style="color: #ff9800;">@_summary.CreditBalance.ToString("C")</strong> as cash.</p>
                        <div class="mb-3">
                            <label class="form-label">Refund Amount <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="_refundCreditAmount" min="0.01"
                                   max="@_summary.CreditBalance" step="0.01" />
                            <div class="form-text">Maximum: @_summary.CreditBalance.ToString("C")</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Refund Method <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="_refundCreditMethod">
                                <option value="@PaymentMethod.Cash">Cash</option>
                                <option value="@PaymentMethod.Cheque">Cheque</option>
                                <option value="@PaymentMethod.BankTransfer">Bank Transfer</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Refund Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" @bind="_refundCreditDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="_refundCreditReason"
                                      placeholder="e.g., Parent requested cash refund..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelRefundCredit">Close</button>
                        <button type="button" class="btn btn-info text-white" @onclick="RefundCredit"
                                disabled="@(_isRefundingCredit || string.IsNullOrWhiteSpace(_refundCreditReason) || _refundCreditAmount <= 0 || _refundCreditAmount > _summary.CreditBalance)">
                            @if (_isRefundingCredit)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            <i class="bi bi-wallet2"></i> Refund Credit
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
