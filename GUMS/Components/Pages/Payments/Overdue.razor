@page "/Payments/Overdue"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Overdue Payments - GUMS</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-exclamation-triangle-fill me-2" style="color: var(--gg-error);"></i> Overdue Payments
        </h2>
        <a href="/Payments" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Payments
        </a>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="ClearError"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading overdue payments...</p>
        </div>
    }
    else if (!_overduePayments.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i>
            <strong>Great news!</strong> There are no overdue payments at this time.
        </div>
    }
    else
    {
        <!-- Summary -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card h-100" style="border-top: 3px solid var(--gg-error);">
                    <div class="card-body text-center">
                        <h3 class="mb-0" style="color: var(--gg-error);">@_overduePayments.Count</h3>
                        <p class="text-muted mb-0">Overdue Payments</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100" style="border-top: 3px solid var(--gg-error);">
                    <div class="card-body text-center">
                        <h3 class="mb-0" style="color: var(--gg-error);">@_totalOverdueAmount.ToString("C")</h3>
                        <p class="text-muted mb-0">Total Outstanding</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100" style="border-top: 3px solid var(--gg-error);">
                    <div class="card-body text-center">
                        <h3 class="mb-0" style="color: var(--gg-error);">@_membersWithOverdue</h3>
                        <p class="text-muted mb-0">Members Affected</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tips Card (hidden on mobile) -->
        <div class="card mb-4 d-none d-md-block" style="border-left: 4px solid var(--gg-primary-blue);">
            <div class="card-body">
                <h6 class="mb-2" style="color: var(--gg-dark-navy);"><i class="bi bi-lightbulb me-1"></i> Tips for Following Up</h6>
                <ul class="mb-0 text-muted">
                    <li>Send a friendly reminder via email or text to the family</li>
                    <li>Mention the payment at the next meeting</li>
                    <li>For persistent issues, speak privately with parents</li>
                    <li>Consider offering payment plans for families in difficulty</li>
                    <li>Record partial payments to track progress</li>
                </ul>
            </div>
        </div>

        <!-- Overdue Payments by Member -->
        @foreach (var group in _paymentsByMember)
        {
            var memberName = _memberNames.GetValueOrDefault(group.Key, group.Key);
            var memberTotal = group.Value.Sum(p => p.OutstandingBalance);
            var oldestOverdue = group.Value.Min(p => (DateTime.Today - p.DueDate).Days);

            <div class="card mb-3">
                <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-1"
                     style="background-color: var(--gg-dark-navy); color: white;">
                    <div>
                        <h5 class="mb-0">
                            <a href="/Payments/MemberHistory/@group.Key" class="text-white text-decoration-none">
                                @memberName
                            </a>
                            <small class="ms-2 d-none d-md-inline" style="opacity: 0.65;">(@group.Key)</small>
                        </h5>
                    </div>
                    <div>
                        <span class="badge bg-danger me-2">@memberTotal.ToString("C")</span>
                        <span class="badge badge-gg-pending">@oldestOverdue+ days</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th class="d-none d-md-table-cell">Reference</th>
                                    <th class="d-none d-lg-table-cell">Type</th>
                                    <th class="d-none d-md-table-cell">Due Date</th>
                                    <th>Overdue</th>
                                    <th class="d-none d-md-table-cell text-end">Amount</th>
                                    <th class="text-end">Outstanding</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in group.Value)
                                {
                                    var daysOverdue = (DateTime.Today - payment.DueDate).Days;

                                    <tr>
                                        <td class="d-none d-md-table-cell">@payment.Reference</td>
                                        <td class="d-none d-lg-table-cell">
                                            @if (payment.PaymentType == PaymentType.Subs)
                                            {
                                                <span class="badge badge-gg-subs">Subs</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-gg-activity">Activity</span>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell">@payment.DueDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (daysOverdue > 30)
                                            {
                                                <span class="fw-bold" style="color: var(--gg-error);">@daysOverdue<span class="d-none d-sm-inline"> days</span></span>
                                            }
                                            else
                                            {
                                                <span>@daysOverdue<span class="d-none d-sm-inline"> days</span></span>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell text-end">@payment.Amount.ToString("C")</td>
                                        <td class="text-end">
                                            <strong style="color: var(--gg-error);">@payment.OutstandingBalance.ToString("C")</strong>
                                        </td>
                                        <td>
                                            <a href="/Payments/RecordPayment/@payment.Id" class="btn btn-sm btn-success">
                                                <i class="bi bi-cash"></i> <span class="d-none d-md-inline">Record</span> Pay
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>
