@page "/Programme/Badges"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Badge Management - GUMS</PageTitle>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Badges</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Badge Management</h2>
        <button class="btn btn-primary" @onclick="ShowAddBadge">
            <i class="bi bi-plus-circle"></i> Add Badge
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = string.Empty"></button>
        </div>
    }

    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Theme</label>
                    <select class="form-select form-select-sm" @onchange="OnThemeFilterChanged">
                        <option value="">All Themes</option>
                        @foreach (var theme in Enum.GetValues<Theme>())
                        {
                            <option value="@theme">@GUMS.Services.ProgrammeService.GetThemeDisplayName(theme)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Section</label>
                    <select class="form-select form-select-sm" @onchange="OnSectionFilterChanged">
                        <option value="">All Sections</option>
                        @foreach (var sec in Enum.GetValues<Section>())
                        {
                            <option value="@sec">@sec</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label form-label-sm">Type</label>
                    <select class="form-select form-select-sm" @onchange="OnTypeFilterChanged">
                        <option value="">All Types</option>
                        <option value="@BadgeType.SkillsBuilder">Skills Builder</option>
                        <option value="@BadgeType.InterestBadge">Interest Badge</option>
                        <option value="@BadgeType.FunBadge">Fun Badge</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!_badges.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-award" style="font-size: 3rem; color: #ccc;"></i>
            <p class="text-muted mt-2">No badges found. Add your first badge to get started.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var badge in _badges)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center"
                             style="background-color: @(badge.Theme.HasValue ? GetThemeColor(badge.Theme.Value) : "#6c757d"); color: white;">
                            <div>
                                <strong>@badge.Name</strong>
                                @if (badge.Stage.HasValue)
                                {
                                    <span class="badge bg-light text-dark ms-1">Stage @badge.Stage</span>
                                }
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light" @onclick="() => ShowEditBadge(badge)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <span class="badge bg-info">@badge.Section</span>
                                <span class="badge @(badge.BadgeType switch { BadgeType.SkillsBuilder => "bg-primary", BadgeType.InterestBadge => "bg-success", BadgeType.FunBadge => "bg-warning text-dark", _ => "bg-secondary" })">
                                    @(badge.BadgeType switch { BadgeType.SkillsBuilder => "Skills Builder", BadgeType.InterestBadge => "Interest Badge", BadgeType.FunBadge => "Fun Badge", _ => badge.BadgeType.ToString() })
                                </span>
                                @if (badge.Theme.HasValue)
                                {
                                    <span class="badge bg-secondary">@GUMS.Services.ProgrammeService.GetThemeDisplayName(badge.Theme.Value)</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(badge.SkillsBuilderName))
                            {
                                <small class="text-muted d-block">Group: @badge.SkillsBuilderName</small>
                            }
                            <small class="text-muted">@badge.RequiredCompletions of @badge.Clauses.Count clauses needed</small>

                            @if (badge.Clauses.Any())
                            {
                                <hr class="my-2" />
                                <ul class="list-unstyled mb-0">
                                    @foreach (var clause in badge.Clauses.OrderBy(c => c.SortOrder))
                                    {
                                        <li class="small">
                                            <i class="bi bi-check-circle text-muted"></i> @clause.Name
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Add/Edit Badge Modal -->
    @if (_showBadgeModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header" style="background-color: var(--gg-primary-blue); color: white;">
                        <h5 class="modal-title">@(_editingBadge.Id > 0 ? "Edit Badge" : "Add Badge")</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Name</label>
                                <input type="text" class="form-control" @bind="_editingBadge.Name" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Type</label>
                                <select class="form-select" @onchange="OnBadgeTypeChanged">
                                    <option value="@BadgeType.SkillsBuilder" selected="@(_editingBadge.BadgeType == BadgeType.SkillsBuilder)">Skills Builder</option>
                                    <option value="@BadgeType.InterestBadge" selected="@(_editingBadge.BadgeType == BadgeType.InterestBadge)">Interest Badge</option>
                                    <option value="@BadgeType.FunBadge" selected="@(_editingBadge.BadgeType == BadgeType.FunBadge)">Fun Badge</option>
                                </select>
                            </div>
                            @if (_editingBadge.BadgeType != BadgeType.FunBadge)
                            {
                                <div class="col-md-4">
                                    <label class="form-label">Theme</label>
                                    <select class="form-select" @bind="_editingBadge.Theme">
                                        @foreach (var theme in Enum.GetValues<Theme>())
                                        {
                                            <option value="@theme">@GUMS.Services.ProgrammeService.GetThemeDisplayName(theme)</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="col-md-4">
                                <label class="form-label">Section</label>
                                <select class="form-select" @bind="_editingBadge.Section">
                                    @foreach (var sec in Enum.GetValues<Section>())
                                    {
                                        <option value="@sec">@sec</option>
                                    }
                                </select>
                            </div>
                            @if (_editingBadge.BadgeType != BadgeType.FunBadge)
                            {
                                <div class="col-md-4">
                                    <label class="form-label">Required Completions</label>
                                    <input type="number" class="form-control" @bind="_editingBadge.RequiredCompletions" min="1" />
                                </div>
                            }

                            @if (_editingBadge.BadgeType == BadgeType.SkillsBuilder)
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Skills Builder Group Name</label>
                                    <input type="text" class="form-control" @bind="_editingBadge.SkillsBuilderName"
                                           placeholder="e.g. Lead, Life Skills" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Stage</label>
                                    <input type="number" class="form-control" @bind="_editingBadge.Stage" min="1" max="6" />
                                </div>
                            }

                            @if (_editingBadge.BadgeType != BadgeType.FunBadge)
                            {
                                <!-- Clauses Section -->
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label mb-0">Clauses</label>
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddClause">
                                            <i class="bi bi-plus"></i> Add Clause
                                        </button>
                                    </div>
                                    @for (int i = 0; i < _editingClauses.Count; i++)
                                    {
                                        var index = i;
                                        <div class="input-group mb-2">
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Clause name"
                                                   @bind="_editingClauses[index].Name" />
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Description (optional)"
                                                   @bind="_editingClauses[index].Description" />
                                            <input type="number" class="form-control form-control-sm"
                                                   style="max-width: 80px;"
                                                   placeholder="Mins"
                                                   @bind="_editingClauses[index].EstimatedMinutes" />
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveClause(index)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        @if (_editingBadge.Id > 0)
                        {
                            <button type="button" class="btn btn-outline-danger" @onclick="DeleteBadge">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        }
                        <button type="button" class="btn btn-primary" @onclick="SaveBadge" disabled="@_isSaving">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Save Badge
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
