@page "/Programme/Progress/{MembershipNumber}"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Girl Progress - GUMS</PageTitle>

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Programme/Overview">Programme</a></li>
            <li class="breadcrumb-item active">Girl Progress</li>
        </ol>
    </nav>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_progress == null)
    {
        <div class="alert alert-danger">Member not found.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>@(_progress.Name ?? MembershipNumber)</h2>
                <p class="text-muted mb-0">
                    @if (_progress.Section.HasValue)
                    {
                        <span class="badge bg-info">@_progress.Section</span>
                    }
                    <span class="ms-2">@MembershipNumber</span>
                </p>
            </div>
        </div>

        <!-- Award Summary -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-around text-center">
                    <div>
                        <h3 class="mb-0">@_progress.Awards.ThemeAwardsEarned / 6</h3>
                        <small class="text-muted">Theme Awards</small>
                    </div>
                    <div>
                        <h3 class="mb-0 @(_progress.Awards.BronzeEarned ? "text-warning" : "text-muted")">
                            @(_progress.Awards.BronzeEarned ? "Earned" : "—")
                        </h3>
                        <small class="text-muted">Bronze</small>
                    </div>
                    <div>
                        <h3 class="mb-0 @(_progress.Awards.SilverEarned ? "text-secondary" : "text-muted")">
                            @(_progress.Awards.SilverEarned ? "Earned" : "—")
                        </h3>
                        <small class="text-muted">Silver</small>
                    </div>
                    <div>
                        <h3 class="mb-0 @(_progress.Awards.GoldEarned ? "text-warning" : "text-muted")">
                            @(_progress.Awards.GoldEarned ? "Earned" : "—")
                        </h3>
                        <small class="text-muted">Gold</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Theme Progress Cards -->
        <div class="row">
            @foreach (var theme in _progress.ThemeProgress)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 @(theme.ThemeAwardEarned ? "border-success" : "")">
                        <div class="card-header text-white" style="background-color: @Badges.GetThemeColor(theme.Theme);">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>@theme.ThemeDisplayName</strong>
                                @if (theme.ThemeAwardEarned)
                                {
                                    <span class="badge bg-light text-success">Theme Award Earned</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Skills Builder -->
                            <h6 class="mb-2">
                                Skills Builders
                                @if (theme.HasCompletedSkillsBuilder)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                            </h6>
                            @if (theme.SkillsBuilders.Any())
                            {
                                @foreach (var badge in theme.SkillsBuilders)
                                {
                                    <div class="mb-1">
                                        <div class="d-flex justify-content-between align-items-center"
                                             role="button" @onclick="() => ToggleBadgeExpanded(badge.BadgeDefinitionId)">
                                            <small>
                                                <i class="bi @(IsBadgeExpanded(badge.BadgeDefinitionId) ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>
                                                @badge.BadgeName
                                            </small>
                                            <small class="@(badge.IsComplete ? "text-success fw-bold" : "text-muted")">
                                                @badge.ClausesCompleted/@badge.RequiredCompletions
                                            </small>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @(badge.IsComplete ? "bg-success" : "bg-primary")"
                                                 style="width: @(badge.RequiredCompletions > 0 ? Math.Min(100, badge.ClausesCompleted * 100 / badge.RequiredCompletions) : 0)%"></div>
                                        </div>
                                        @if (IsBadgeExpanded(badge.BadgeDefinitionId) && badge.Clauses.Any())
                                        {
                                            <div class="ms-3 mt-1">
                                                @foreach (var clause in badge.Clauses)
                                                {
                                                    var clauseId = clause.BadgeClauseId;
                                                    var isCompleted = clause.Completed;
                                                    <div class="form-check form-check-sm">
                                                        <input class="form-check-input" type="checkbox"
                                                               checked="@isCompleted"
                                                               disabled="@_isSaving"
                                                               @onchange="() => ToggleClauseCompletion(clauseId, !isCompleted)"
                                                               id="clause-@clauseId" />
                                                        <label class="form-check-label small" for="clause-@clauseId">
                                                            @clause.Name
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <small class="text-muted">No skills builders for this theme</small>
                            }

                            <hr class="my-2" />

                            <!-- Interest Badges -->
                            <h6 class="mb-2">
                                Interest Badges
                                @if (theme.HasCompletedInterestBadge)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                            </h6>
                            @if (theme.InterestBadges.Any())
                            {
                                @foreach (var badge in theme.InterestBadges)
                                {
                                    <div class="mb-1">
                                        <div class="d-flex justify-content-between align-items-center"
                                             role="button" @onclick="() => ToggleBadgeExpanded(badge.BadgeDefinitionId)">
                                            <small>
                                                <i class="bi @(IsBadgeExpanded(badge.BadgeDefinitionId) ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>
                                                @badge.BadgeName
                                            </small>
                                            <small class="@(badge.IsComplete ? "text-success fw-bold" : "text-muted")">
                                                @badge.ClausesCompleted/@badge.RequiredCompletions
                                            </small>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @(badge.IsComplete ? "bg-success" : "bg-info")"
                                                 style="width: @(badge.RequiredCompletions > 0 ? Math.Min(100, badge.ClausesCompleted * 100 / badge.RequiredCompletions) : 0)%"></div>
                                        </div>
                                        @if (IsBadgeExpanded(badge.BadgeDefinitionId) && badge.Clauses.Any())
                                        {
                                            <div class="ms-3 mt-1">
                                                @foreach (var clause in badge.Clauses)
                                                {
                                                    var clauseId = clause.BadgeClauseId;
                                                    var isCompleted = clause.Completed;
                                                    <div class="form-check form-check-sm">
                                                        <input class="form-check-input" type="checkbox"
                                                               checked="@isCompleted"
                                                               disabled="@_isSaving"
                                                               @onchange="() => ToggleClauseCompletion(clauseId, !isCompleted)"
                                                               id="clause-@clauseId" />
                                                        <label class="form-check-label small" for="clause-@clauseId">
                                                            @clause.Name
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <small class="text-muted">No interest badges for this theme</small>
                            }

                            <hr class="my-2" />

                            <!-- UMA Hours -->
                            <h6 class="mb-2">
                                UMA Hours
                                @if (theme.HasRequiredUmaMinutes)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                            </h6>
                            <div class="d-flex justify-content-between align-items-center">
                                <small>@theme.UmaMinutesCompleted / @theme.UmaMinutesRequired minutes</small>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @(theme.HasRequiredUmaMinutes ? "bg-success" : "bg-warning")"
                                     style="width: @(theme.UmaMinutesRequired > 0 ? Math.Min(100, theme.UmaMinutesCompleted * 100 / theme.UmaMinutesRequired) : 0)%"></div>
                            </div>
                            @if (_umasByTheme.TryGetValue(theme.Theme, out var umas) && umas.Any())
                            {
                                <div class="mt-2">
                                    @foreach (var uma in umas)
                                    {
                                        var umaId = uma.Id;
                                        var isUmaCompleted = _completedUmaIds.Contains(umaId);
                                        <div class="form-check form-check-sm">
                                            <input class="form-check-input" type="checkbox"
                                                   checked="@isUmaCompleted"
                                                   disabled="@_isSaving"
                                                   @onchange="() => ToggleUmaCompletion(umaId, !isUmaCompleted)"
                                                   id="uma-@umaId" />
                                            <label class="form-check-label small" for="uma-@umaId">
                                                @uma.Name (@uma.Minutes min)
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Gold Challenge -->
        <div class="card mt-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <strong>Gold Challenge</strong>
                    <p class="text-muted mb-0">Required for Gold Award (in addition to 6 Theme Awards)</p>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           checked="@_progress.Awards.GoldChallengeComplete"
                           @onchange="ToggleGoldChallenge"
                           style="width: 3em; height: 1.5em;" />
                </div>
            </div>
        </div>
    }
</div>
