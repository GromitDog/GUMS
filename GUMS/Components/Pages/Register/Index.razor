@page "/Register"
@using GUMS.Data.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Member Register - GUMS</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <h2>Member Register</h2>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline-primary" @onclick="OpenEmailList">
                <i class="bi bi-envelope"></i> Email list
            </button>
            <a href="/Register/AddGirl" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Add Girl
            </a>
            <a href="/Register/AddLeader" class="btn btn-secondary">
                <i class="bi bi-person-plus-fill"></i> Add Leader
            </a>
        </div>
    </div>

    @if (_showEmailModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-envelope"></i> Email list</h5>
                        <button type="button" class="btn-close" @onclick="CloseEmailList"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-2">Emails are from active members only. Paste into the BCC field of your email client.</p>

                        <div class="btn-group mb-3" role="group">
                            <input type="radio" class="btn-check" name="emailFilter" id="emailFilterAll" checked="@(_emailFilter == "all")" @onchange="@(() => SetEmailFilter("all"))" />
                            <label class="btn btn-outline-primary" for="emailFilterAll">All (@GetEmailCount("all"))</label>

                            <input type="radio" class="btn-check" name="emailFilter" id="emailFilterParents" checked="@(_emailFilter == "parents")" @onchange="@(() => SetEmailFilter("parents"))" />
                            <label class="btn btn-outline-primary" for="emailFilterParents">Girls' parents (@GetEmailCount("parents"))</label>

                            <input type="radio" class="btn-check" name="emailFilter" id="emailFilterLeaders" checked="@(_emailFilter == "leaders")" @onchange="@(() => SetEmailFilter("leaders"))" />
                            <label class="btn btn-outline-primary" for="emailFilterLeaders">Leaders (@GetEmailCount("leaders"))</label>
                        </div>

                        @{
                            var emailText = GetEmailText();
                        }

                        @if (string.IsNullOrEmpty(emailText))
                        {
                            <div class="alert alert-info mb-0">No email addresses on file for this group.</div>
                        }
                        else
                        {
                            <textarea class="form-control" rows="6" readonly @ref="_emailTextarea">@emailText</textarea>
                        }

                        @if (!string.IsNullOrEmpty(_copyMessage))
                        {
                            <div class="mt-2 text-success small"><i class="bi bi-check-circle"></i> @_copyMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseEmailList">Close</button>
                        <button type="button" class="btn btn-primary" @onclick="CopyEmails" disabled="@string.IsNullOrEmpty(emailText)">
                            <i class="bi bi-clipboard"></i> Copy to clipboard
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filters and Search -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Find someone</label>
                    <input type="text" class="form-control" @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="Type a name or membership number" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Show me</label>
                    <select class="form-select" @bind="_filterType" @bind:after="LoadMembers">
                        <option value="">Everyone</option>
                        <option value="Girl">Girls only</option>
                        <option value="Leader">Leaders only</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="_filterStatus" @bind:after="LoadMembers">
                        <option value="active">Active</option>
                        <option value="inactive">Left</option>
                        <option value="all">All</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Members List -->
    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading members...</p>
        </div>
    }
    else if (!_members.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Your register is empty. Add your first girl or leader to get started!
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                @{
                    var girls = _members.Where(m => m.PersonType == PersonType.Girl).OrderBy(m => m.FullName).ToList();
                    var leaders = _members.Where(m => m.PersonType == PersonType.Leader).OrderBy(m => m.FullName).ToList();
                }

                <p class="text-muted mb-3">Showing @_members.Count member(s) (@girls.Count girl(s), @leaders.Count leader(s))</p>

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th class="d-none d-md-table-cell">Membership Number</th>
                                <th>Name</th>
                                <th class="d-none d-lg-table-cell">Type</th>
                                <th>Status</th>
                                <th class="d-none d-md-table-cell">Date Joined</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (girls.Any())
                            {
                                <tr class="table-active">
                                    <td colspan="6" class="fw-bold" style="background-color: #E3F2FD; color: #007BC4;">
                                        <i class="bi bi-people-fill"></i> Girls (@girls.Count)
                                    </td>
                                </tr>
                                @foreach (var member in girls)
                                {
                                    <tr>
                                        <td class="d-none d-md-table-cell">@member.MembershipNumber</td>
                                        <td>
                                            @if (member.IsDataRemoved)
                                            {
                                                <span class="text-muted fst-italic">Removed Member</span>
                                            }
                                            else
                                            {
                                                @member.FullName
                                            }
                                        </td>
                                        <td class="d-none d-lg-table-cell">
                                            <span class="badge bg-info">
                                                @member.PersonType
                                            </span>
                                        </td>
                                        <td>
                                            @if (member.IsDataRemoved)
                                            {
                                                <span class="badge bg-dark">Data Removed</span>
                                            }
                                            else if (member.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Inactive</span>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell">@member.DateJoined.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="/Register/View/@member.Id" class="btn btn-outline-primary">View</a>
                                                @if (!member.IsDataRemoved)
                                                {
                                                    <a href="/Register/Edit/@member.Id" class="btn btn-outline-secondary">Edit</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }

                            @if (leaders.Any())
                            {
                                <tr class="table-active">
                                    <td colspan="6" class="fw-bold" style="background-color: #F5F5F5; color: #161B4E;">
                                        <i class="bi bi-award-fill"></i> Leaders (@leaders.Count)
                                    </td>
                                </tr>
                                @foreach (var member in leaders)
                                {
                                    <tr>
                                        <td class="d-none d-md-table-cell">@member.MembershipNumber</td>
                                        <td>
                                            @if (member.IsDataRemoved)
                                            {
                                                <span class="text-muted fst-italic">Removed Member</span>
                                            }
                                            else
                                            {
                                                @member.FullName
                                            }
                                        </td>
                                        <td class="d-none d-lg-table-cell">
                                            <span class="badge bg-secondary">
                                                @member.PersonType
                                            </span>
                                        </td>
                                        <td>
                                            @if (member.IsDataRemoved)
                                            {
                                                <span class="badge bg-dark">Data Removed</span>
                                            }
                                            else if (member.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Inactive</span>
                                            }
                                        </td>
                                        <td class="d-none d-md-table-cell">@member.DateJoined.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="/Register/View/@member.Id" class="btn btn-outline-primary">View</a>
                                                @if (!member.IsDataRemoved)
                                                {
                                                    <a href="/Register/Edit/@member.Id" class="btn btn-outline-secondary">Edit</a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
